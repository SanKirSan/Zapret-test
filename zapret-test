sync_domain_lists() {
    ensure_default_files
    [ "${ENABLE_LIST_AUTOUPDATE:-1}" = 0 ] && { say "$(t LIST_DISABLED)"; SERVICE_DB="$SERVICES"; return 0; }
    mkdir -p "$DOMAIN_LIST_DIR" "$RUN/lists" 2>/dev/null || true
    if ! command -v curl >/dev/null 2>&1 && ! command -v wget >/dev/null 2>&1; then SERVICE_DB="$SERVICES"; return 0; fi
    say "$(t LIST_UPDATE)"
    [ -f "$DOMAIN_SOURCES" ] || { SERVICE_DB="$SERVICES"; return 0; }
    while IFS='|' read -r svc url filter required; do
        case "$svc" in ''|\#*) continue;; esac
        cache="$DOMAIN_LIST_DIR/${svc}.lst"; tmp="$RUN/lists/${svc}.tmp"; ok=0
        if command -v curl >/dev/null 2>&1; then
            curl -fsSL --connect-timeout 5 --max-time 8 "$url" -o "$tmp" 2>/dev/null && ok=1
        fi
        if [ "$ok" -ne 1 ] && command -v wget >/dev/null 2>&1; then
            wget -q -T 8 -O "$tmp" "$url" && ok=1
        fi
        source_valid=0
        if [ "$ok" = 1 ]; then
            normalized="$RUN/lists/${svc}.normalized"
            awk 'NF && $1 !~ /^#/ && $1 !~ /^;/ {gsub(/^\*\./,"",$1); print tolower($1)}' "$tmp" | sort -u > "$normalized"
            valid_count=$(awk '$1 ~ /^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$/ {n++} END{print n+0}' "$normalized" 2>/dev/null)
            [ "$valid_count" -ge 2 ] && source_valid=1
            oldifs="$IFS"; IFS=','
            for sentinel in $required; do
                needle="$(printf '%s' "$sentinel" | tr '[:upper:]' '[:lower:]')"
                grep -Fxq "$needle" "$normalized" 2>/dev/null || { source_valid=0; break; }
            done
            IFS="$oldifs"
        fi
        if [ "$source_valid" = 1 ]; then
            old_sha=""
            [ -s "$cache" ] && old_sha="$(sha256sum "$cache" 2>/dev/null | awk '{print $1}')"
            awk -v filter="$filter" 'NF && $1 !~ /^#/ && $1 !~ /^;/ {gsub(/^\*\./,"",$1); v=tolower($1); valid=(v ~ /^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$/); if (valid && filter=="all") print v; else if (valid && filter=="instagram" && (v ~ /instagram/ || v=="ig.me" || v ~ /(^|\.)fbcdn\.net$/ || v ~ /(^|\.)fbsbx\.com$/)) print v}' "$tmp" | sort -u > "$cache"
            rm -f "$tmp" "$normalized"
            cnt=$(wc -l < "$cache" 2>/dev/null | tr -d ' ')
            new_sha="$(sha256sum "$cache" 2>/dev/null | awk '{print $1}')"
            sync_time="$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || true)"
            printf '%s|%s|%s|%s\n' "$svc" "$sync_time" "$cnt" "$new_sha" > "$DOMAIN_LIST_DIR/${svc}.meta"
            if [ -n "$old_sha" ] && [ "$old_sha" = "$new_sha" ]; then
                [ "${LANG_MODE:-RU}" = RU ] && printf '  [OK] %s — %s доменов — без изменений\n' "$svc" "$cnt" || printf '  [OK] %s — %s domains — unchanged\n' "$svc" "$cnt"
            else
                [ "${LANG_MODE:-RU}" = RU ] && printf '  [ОБНОВЛЕНО] %s — %s доменов — %s\n' "$svc" "$cnt" "$sync_time" || printf '  [UPDATED] %s — %s domains — %s\n' "$svc" "$cnt" "$sync_time"
            fi
        elif [ -s "$cache" ]; then
            cache_valid=1
            cache_count=$(awk '$1 ~ /^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$/ {n++} END{print n+0}' "$cache" 2>/dev/null)
            [ "$cache_count" -ge 2 ] || cache_valid=0
            oldifs="$IFS"; IFS=','
            for sentinel in $required; do needle="$(printf '%s' "$sentinel" | tr '[:upper:]' '[:lower:]')"; grep -Fxq "$needle" "$cache" 2>/dev/null || { cache_valid=0; break; }; done
            IFS="$oldifs"
            if [ "$cache_valid" = 1 ]; then
                rm -f "$tmp"; cnt=$(wc -l < "$cache" 2>/dev/null | tr -d ' '); [ "${LANG_MODE:-RU}" = RU ] && printf '  [CACHE] %s — %s доменов\n' "$svc" "$cnt" || printf '  [CACHE] %s — %s domains\n' "$svc" "$cnt"
            else
                rm -f "$tmp" "$cache"; [ "${LANG_MODE:-RU}" = RU ] && printf '  [WARN] %s — повреждённый кэш удалён, используется встроенный список\n' "$svc" || printf '  [WARN] %s — invalid cache removed, using bundled list\n' "$svc"
            fi
        else
            rm -f "$tmp"; [ "${LANG_MODE:-RU}" = RU ] && printf '  [WARN] %s — список недоступен, используется встроенный список\n' "$svc" || printf '  [WARN] %s — source unavailable, using bundled list\n' "$svc"
        fi
    done < "$DOMAIN_SOURCES"
    cp "$SERVICES" "$RUN/services-runtime.conf"
    for svc in YouTube Discord Telegram Instagram TikTok; do
        cache="$DOMAIN_LIST_DIR/${svc}.lst"; [ -s "$cache" ] || continue
        old="$(awk -v svc="$svc" '/^SERVICE=/{cur=$0; sub(/^SERVICE=/,"",cur); gsub(/^"|"$/,"",cur); in_s=(cur==svc); next} in_s && /^DOMAINS=/{x=$0; sub(/^DOMAINS=/,"",x); gsub(/^"|"$/,"",x); print x; exit}' "$SERVICES")"
        merged="$(printf '%s\n' $old; cat "$cache")"; merged="$(printf '%s\n' "$merged" | tr '[:upper:]' '[:lower:]' | sed '/^$/d' | sort -u | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
        awk -v svc="$svc" -v dom="$merged" '/^SERVICE=/{cur=$0; sub(/^SERVICE=/,"",cur); gsub(/^"|"$/,"",cur); in_s=(cur==svc)} in_s && /^DOMAINS=/{print "DOMAINS=\"" dom "\""; in_s=0; next} {print}' "$RUN/services-runtime.conf" > "$RUN/services-runtime.tmp" && mv "$RUN/services-runtime.tmp" "$RUN/services-runtime.conf"
    done
    SERVICE_DB="$RUN/services-runtime.conf"
}
