# ---------- blockcheck orchestration ----------
run_engine_blockcheck() {
    engine="$1"
    namespace="${2:-S}"
    if [ -s "$STATE/blockcheck.domain" ]; then
        all="$(cat "$STATE/blockcheck.domain" 2>/dev/null)"
    else
        all=""
    fi
    [ -n "$all" ] || return 1
    say ''
    say "[$(t TAG_TARGET)]"
    if [ -s "$STATE/blockcheck.service" ]; then
        if [ "${LANG_MODE:-RU}" = RU ]; then say "  Сервис: $(cat "$STATE/blockcheck.service")"; else say "  Service: $(cat "$STATE/blockcheck.service")"; fi
    fi
    if [ "${LANG_MODE:-RU}" = RU ]; then say "  Домен : $all"; else say "  Domain : $all"; fi
    case "$engine" in
      ZAPRET) [ -n "$BLOCKCHECK" ] || return 1; run_blockcheck ZAPRET "$all" "$BLOCKCHECK_SCANLEVEL"; run_rc=$?;;
      ZAPRET2) [ -n "$BLOCKCHECK2" ] || return 1; run_blockcheck ZAPRET2 "$all" "$BLOCKCHECK_SCANLEVEL"; run_rc=$?;;
      *) return 1;;
    esac
    # Never parse/generate candidate databases after an interrupted or failed
    # upstream blockcheck. This is what previously caused Sxxxx output after ^C.
    case "$run_rc" in
        130|143) return "$run_rc";;
        0) :;;
        *) return "$run_rc";;
    esac
    case "$engine" in
      ZAPRET) raw="$BLOCKDIR/blockcheck-latest.txt";;
      ZAPRET2) raw="$BLOCKDIR/blockcheck2-latest.txt";;
    esac
    [ -f "$raw" ] || return 1
    if ! grep -Eq '\* script :|!!!!! AVAILABLE !!!!!|UNAVAILABLE code=' "$raw" 2>/dev/null; then
        say "[$(t TAG_WARNING)] Upstream blockcheck completed without any strategy test results."
    fi
    cand="$(extract_candidates "$raw" "$engine")"
    make_candidate_db "$engine" "$raw" "$cand" "$namespace"
}

# ---------- report ----------
generate_best_configs() {
    rm -f "$BEST_Z" "$BEST_Z2"
    for e in ZAPRET ZAPRET2; do
        [ -s "$RUN/strategy-results" ] || continue
        best="$(awk -F'|' -v e="$e" '$2==e && $4=="PASS" {print $5"|"$1"|"$3} ' "$RUN/strategy-results" | sort -t'|' -k1,1nr | head -n1)"
        [ -n "$best" ] || best="$(awk -F'|' -v e="$e" '$2==e {print $5"|"$1"|"$3} ' "$RUN/strategy-results" | sort -t'|' -k1,1nr | head -n1)"
        [ -n "$best" ] || continue
        score=$(echo "$best" | cut -d'|' -f1)
        id=$(echo "$best" | cut -d'|' -f2)
        args=$(echo "$best" | cut -d'|' -f3-)
        if [ "$e" = ZAPRET ]; then
          cat > "$BEST_Z" <<EOF2
# Generated by zapret-test.
# STATUS=VERIFIED only when the report shows PASS.
ID=$id
ENGINE=$e
SCORE=$score
COMMAND=$args
EOF2
        else
          cat > "$BEST_Z2" <<EOF2
# Generated by zapret-test.
# STATUS=VERIFIED only when the report shows PASS.
ID=$id
ENGINE=$e
SCORE=$score
COMMAND=$args
EOF2
        fi
    done
}

finalize_report() {
    generate_best_configs
    {
      echo
      echo '=================================================='
      echo 'FINAL RESULT'
      echo '=================================================='
      echo "ENGINE ZAPRET: ${ZAPRET_VERSION:-UNAVAILABLE}"
      echo "ENGINE ZAPRET2: ${ZAPRET2_VERSION:-UNAVAILABLE}"
      echo "FW: $FW"
      echo "SELECTED SERVICES:"
      cat "$STATE/services.list" | sed 's/^/  /'
      echo
      echo 'TOP STRATEGIES'
      if [ -s "$RUN/strategy-results" ]; then
        sort -t'|' -k5,5nr "$RUN/strategy-results" | head -n 10 | awk -F'|' '{printf "  %-12s %-8s SCORE=%-3s SERVICES=%-7s SIDE_EFFECT=%s\n",$1,$4,$5,$6,$7}'
      else echo '  NONE'; fi
      echo
      echo 'BLOCKCHECK RAW:'
      ls -l "$BLOCKDIR" 2>/dev/null || true
      echo
      echo 'EXTERNAL / VPS-STYLE TESTS:'
      ls -l "$EXTERNAL_DIR"/*.txt 2>/dev/null || echo '  NONE'
      echo
      echo 'RESTORE STATUS:' "$([ "$ROLLBACK_OK" = 1 ] && echo OK || echo CRITICAL)"
      echo
      echo 'IMPORTANT: blockcheck output is candidate evidence; only strategies verified by the real-world test are recommendations.'
    } >> "$REPORT_TXT"
    # Keep JSON deliberately generated from machine-readable result files instead of complex sed on a template.
    {
      echo '{'
      printf '  "system":{"openwrt":"%s","target":"%s","arch":"%s","device":"%s","kernel":"%s","firewall":"%s","ipv6":"%s"},\n' "$(json_escape "$OW_DESCRIPTION")" "$(json_escape "$OW_TARGET")" "$(json_escape "$ARCH")" "$(json_escape "${DEVICE_MODEL:-unknown}")" "$(json_escape "$KERNEL")" "$(json_escape "$FW")" "$(json_escape "$IPV6_STATE")"
      echo '  "selected_services":['
      first=1; while IFS= read -r s; do [ "$first" = 1 ] || printf ',\n'; first=0; printf '    "%s"' "$(json_escape "$s")"; done < "$STATE/services.list"; echo; echo '  ],'
      echo '  "strategies":['
      first=1; if [ -s "$RUN/strategy-results" ]; then while IFS='|' read -r id eng args st sc svc side; do
        [ "$first" = 1 ] || printf ',\n'; first=0
        printf '    {"id":"%s","engine":"%s","status":"%s","score":%s,"services":"%s","side_effects":%s,"args":"%s"}' \
          "$(json_escape "$id")" "$(json_escape "$eng")" "$(json_escape "$st")" "$sc" "$(json_escape "$svc")" "$side" "$(json_escape "$args")"
      done < "$RUN/strategy-results"; fi
      echo; echo '  ],'
      echo '  "restore_status":"'"$([ "$ROLLBACK_OK" = 1 ] && echo OK || echo CRITICAL)"'"'
      echo '}'
    } > "$REPORT_JSON"
}

