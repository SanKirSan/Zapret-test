# ---------- process control ----------
kill_tree() {
    p="$1"
    [ -n "$p" ] || return 0
    [ -d "/proc/$p" ] || return 0
    children="$(cat "/proc/$p/task/$p/children" 2>/dev/null || true)"
    for c in $children; do kill_tree "$c"; done
    kill -TERM "$p" 2>/dev/null || true
}

kill_active_record() {
    f="$1"
    [ -f "$f" ] || return 1
    IFS='|' read -r p pgid isolated < "$f" || return 1
    case "$p" in ''|*[!0-9]*) rm -f "$f"; return 1;; esac
    if [ "$isolated" = 1 ] && [ -n "$pgid" ]; then
        case "$pgid" in ''|*[!0-9]*) isolated=0;; esac
    fi
    if [ "$isolated" = 1 ] && [ -n "$pgid" ] && [ "$pgid" != "0" ]; then
        say "[$(t TAG_STOP)] terminating isolated process group (pid=$p pgid=$pgid)"
        kill -TERM -"$pgid" 2>/dev/null || true
        sleep 1
        kill -KILL -"$pgid" 2>/dev/null || true
        return 0
    fi
    if kill -0 "$p" 2>/dev/null; then
        say "[$(t TAG_STOP)] terminating test process tree (pid=$p)"
        kill_tree "$p"
        sleep 1
        kill -KILL "$p" 2>/dev/null || true
        return 0
    fi
    return 1
}

proc_cmdline() {
    p="$1"
    [ -r "/proc/$p/cmdline" ] || return 1
    tr '\000' ' ' < "/proc/$p/cmdline" 2>/dev/null | sed 's/[[:space:]]*$//'
}

proc_ppid() {
    p="$1"
    [ -r "/proc/$p/stat" ] || return 1
    awk '{print $4}' "/proc/$p/stat" 2>/dev/null
}

is_zapret_test_cmd() {
    cmd="$1"
    case "$cmd" in
        *'/zapret-test'*|*' zapret-test'|*'/usr/bin/zapret-test'*) return 0;;
    esac
    return 1
}

find_active_zapret_test_root() {
    self="$1"
    for d in /proc/[0-9]*; do
        pid="${d#/proc/}"
        [ -r "$d/cmdline" ] || continue
        [ "$pid" = "$self" ] && continue
        cmd="$(proc_cmdline "$pid" 2>/dev/null || true)"
        [ -n "$cmd" ] || continue
        if is_zapret_test_cmd "$cmd"; then
            case "$cmd" in
                *' stop'*) continue;;
                *' --version'*) continue;;
                *' --help'*) continue;;
            esac
            echo "$pid"
            return 0
        fi
    done
    return 1
}

stop_active_test() {
    stopped=0
    for f in "$RUN/active.blockcheck.pid" "$RUN/active.external.pid"; do
        if kill_active_record "$f"; then stopped=1; fi
        rm -f "$f"
    done
    [ "$stopped" = 1 ] && { rm -f "$RUN/active.main.pid"; return 0; }

    # Cross-version fallback: older zapret-test releases may have lost the
    # active.* marker while their blockcheck process is still running. Find
    # the owning zapret-test process and stop its process tree.
    root_pid="$(find_active_zapret_test_root "$$" 2>/dev/null || true)"
    if [ -n "$root_pid" ]; then
        say "[$(t TAG_STOP)] Found active zapret-test process (pid=$root_pid); terminating process tree."
        kill_tree "$root_pid"
        sleep 1
        kill -KILL "$root_pid" 2>/dev/null || true
        rm -f "$RUN/active.main.pid" "$RUN/active.blockcheck.pid" "$RUN/active.external.pid"
        return 0
    fi

    say '[STOP] No active zapret-test process found.'
    return 1
}

cleanup_on_signal() {
    sig="$1"
    say ''
    say "[$(t TAG_STOP)] Caught $sig. Stopping current test..."
    zapret_test_signal_handler "$sig"
}

# ---------- detection ----------
detect_path() {
    p=""
    for p in "$@"; do [ -x "$p" ] && { echo "$p"; return 0; }; done
    return 1
}

detect_zapret() {
    ZAPRET_BASE=""
    if [ -n "${ZAPRET_TEST_ZAPRET_BASE:-}" ] && [ -f "$ZAPRET_TEST_ZAPRET_BASE/blockcheck.sh" ]; then
        ZAPRET_BASE="$ZAPRET_TEST_ZAPRET_BASE"
        BLOCKCHECK="$ZAPRET_BASE/blockcheck.sh"
        [ -x "$ZAPRET_BASE/nfq/nfqws" ] && NFQWS="$ZAPRET_BASE/nfq/nfqws"
        [ -x "$ZAPRET_BASE/tpws/tpws" ] && TPWS="$ZAPRET_BASE/tpws/tpws"
        return 0
    fi
    BLOCKCHECK=""
    NFQWS=""
    TPWS=""
    for b in /opt/zapret /usr/share/zapret /usr/lib/zapret; do
        [ -f "$b/blockcheck.sh" ] || continue
        ZAPRET_BASE="$b"
        BLOCKCHECK="$b/blockcheck.sh"
        [ -x "$b/nfq/nfqws" ] && NFQWS="$b/nfq/nfqws"
        [ -x "$b/tpws/tpws" ] && TPWS="$b/tpws/tpws"
        break
    done
    [ -n "$BLOCKCHECK" ] || BLOCKCHECK="$(detect_path /usr/bin/blockcheck.sh /usr/sbin/blockcheck.sh 2>/dev/null || true)"
    [ -n "$NFQWS" ] || NFQWS="$(detect_path /usr/bin/nfqws /usr/sbin/nfqws 2>/dev/null || true)"
    [ -n "$TPWS" ] || TPWS="$(detect_path /usr/bin/tpws /usr/sbin/tpws 2>/dev/null || true)"
    [ -n "$BLOCKCHECK" ] && ZAPRET_BASE="$(cd "$(dirname "$BLOCKCHECK")" 2>/dev/null && pwd)"
}

detect_zapret2() {
    ZAPRET2_BASE=""
    if [ -n "${ZAPRET_TEST_ZAPRET2_BASE:-}" ] && [ -f "$ZAPRET_TEST_ZAPRET2_BASE/blockcheck2.sh" ]; then
        ZAPRET2_BASE="$ZAPRET_TEST_ZAPRET2_BASE"
        BLOCKCHECK2="$ZAPRET2_BASE/blockcheck2.sh"
        [ -x "$ZAPRET2_BASE/nfq2/nfqws2" ] && NFQWS2="$ZAPRET2_BASE/nfq2/nfqws2"
        return 0
    fi
    BLOCKCHECK2=""
    NFQWS2=""
    for b in /opt/zapret2 /usr/share/zapret2 /usr/lib/zapret2; do
        [ -f "$b/blockcheck2.sh" ] || continue
        ZAPRET2_BASE="$b"
        BLOCKCHECK2="$b/blockcheck2.sh"
        [ -x "$b/nfq2/nfqws2" ] && NFQWS2="$b/nfq2/nfqws2"
        break
    done
    [ -n "$BLOCKCHECK2" ] || BLOCKCHECK2="$(detect_path /usr/bin/blockcheck2.sh /usr/sbin/blockcheck2.sh 2>/dev/null || true)"
    [ -n "$NFQWS2" ] || NFQWS2="$(detect_path /usr/bin/nfqws2 /usr/sbin/nfqws2 2>/dev/null || true)"
    [ -n "$BLOCKCHECK2" ] && ZAPRET2_BASE="$(cd "$(dirname "$BLOCKCHECK2")" 2>/dev/null && pwd)"
}

get_version() {
    b="$1"
    [ -x "$b" ] || { echo "UNAVAILABLE"; return; }
    for arg in --version -V; do
        out="$($b $arg 2>&1 | head -n 3)"
        [ -n "$out" ] && { echo "$out" | tr '\n' ' '; return; }
    done
    echo "UNKNOWN"
}

detect_fw() {
    FW="unknown"
    if has fw4 && fw4 -q status >/dev/null 2>&1; then FW="fw4/nftables";
    elif has nft && nft list ruleset >/dev/null 2>&1; then FW="nftables";
    elif has fw3 && fw3 status >/dev/null 2>&1; then FW="fw3/iptables";
    elif has iptables && iptables -S >/dev/null 2>&1; then FW="iptables"; fi
    case "$FW" in nftables|fw4/nftables) FWTYPE=nftables;; *) FWTYPE=iptables;; esac
}

detect_system() {
    SYSTEM="$(uname -a 2>/dev/null)"
    OPENWRT_RELEASE="$(cat /etc/openwrt_release 2>/dev/null | tr '\n' ' ' || true)"
    OPENWRT_ID=""; OW_RELEASE=""; OW_REVISION=""; OW_DESCRIPTION=""; OW_TARGET=""; OW_ARCH=""
    if [ -f /etc/openwrt_release ]; then
        . /etc/openwrt_release 2>/dev/null || true
        OPENWRT_ID="${DISTRIB_ID:-}"
        OW_RELEASE="${DISTRIB_RELEASE:-}"
        OW_REVISION="${DISTRIB_REVISION:-}"
        OW_DESCRIPTION="${DISTRIB_DESCRIPTION:-}"
        OW_TARGET="${DISTRIB_TARGET:-}"
        OW_ARCH="${DISTRIB_ARCH:-}"
    fi
    [ -n "$OW_DESCRIPTION" ] || OW_DESCRIPTION="${OPENWRT_ID:-OpenWrt} ${OW_RELEASE:-unknown} ${OW_REVISION:-}"
    BOARD_JSON="$(ubus call system board 2>/dev/null || true)"
    DEVICE_MODEL="$(printf '%s' "$BOARD_JSON" | sed -n 's/.*"model"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
    [ -n "$DEVICE_MODEL" ] || DEVICE_MODEL="$(cat /tmp/sysinfo/model 2>/dev/null || true)"
    [ -n "$DEVICE_MODEL" ] || DEVICE_MODEL="$(printf '%s' "$BOARD_JSON" | sed -n 's/.*"board_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
    [ -n "$DEVICE_MODEL" ] || DEVICE_MODEL="$(cat /tmp/sysinfo/board_name 2>/dev/null || true)"
    ARCH="${OW_ARCH:-}"
    [ -n "$ARCH" ] || ARCH="$(printf '%s' "$BOARD_JSON" | sed -n 's/.*"architecture":"\([^"]*\)".*/\1/p' | head -n1)"
    [ -n "$ARCH" ] || ARCH="$(uname -m)"
    KERNEL="$(uname -r 2>/dev/null)"
    detect_fw
    DNS_SERVERS="$(awk '/^nameserver /{print $2}' /etc/resolv.conf 2>/dev/null | tr '\n' ' ' || true)"
    IPV6_STATE=enabled
    sysctl -n net.ipv6.conf.all.disable_ipv6 2>/dev/null | grep -qx 1 && IPV6_STATE=disabled
}

# ---------- backup/restore ----------
backup_create() {
    rm -rf "$BACKUP"; mkdir -p "$BACKUP"
    date > "$BACKUP/timestamp"
    [ -d /etc/config ] && tar -czf "$BACKUP/etc-config.tgz" /etc/config 2>/dev/null || true
    [ -d /etc/zapret ] && tar -czf "$BACKUP/etc-zapret.tgz" /etc/zapret 2>/dev/null || true
    [ -d /etc/zapret2 ] && tar -czf "$BACKUP/etc-zapret2.tgz" /etc/zapret2 2>/dev/null || true
    [ -f /etc/config/firewall ] && cp -p /etc/config/firewall "$BACKUP/firewall.uci"
    has nft && nft -a list ruleset > "$BACKUP/nft-ruleset.txt" 2>&1 || true
    has iptables-save && iptables-save > "$BACKUP/iptables-save.txt" 2>&1 || true
    has ip6tables-save && ip6tables-save > "$BACKUP/ip6tables-save.txt" 2>&1 || true
    ps w > "$BACKUP/ps.txt" 2>&1 || true
    ubus call system board > "$BACKUP/ubus-board.json" 2>&1 || true
    log "backup created"
}

service_status() {
    if has /etc/init.d/zapret; then /etc/init.d/zapret status > "$BACKUP/zapret-status.txt" 2>&1 || true; fi
    if has /etc/init.d/zapret2; then /etc/init.d/zapret2 status > "$BACKUP/zapret2-status.txt" 2>&1 || true; fi
}

stop_engine_services() {
    ORIG_SERVICE=0
    ZAPRET_WAS_ACTIVE=0
    ZAPRET2_WAS_ACTIVE=0
    if [ -x /etc/init.d/zapret ]; then /etc/init.d/zapret status >/dev/null 2>&1 && { ZAPRET_WAS_ACTIVE=1; /etc/init.d/zapret stop >/dev/null 2>&1 || return 1; ORIG_SERVICE=1; }; fi
    if [ -x /etc/init.d/zapret2 ]; then /etc/init.d/zapret2 status >/dev/null 2>&1 && { ZAPRET2_WAS_ACTIVE=1; /etc/init.d/zapret2 stop >/dev/null 2>&1 || return 1; ORIG_SERVICE=1; }; fi
    sleep "${WAIT_AFTER_RESTART:-3}"
    return 0
}

restart_engine_services() {
    rc=0
    if [ "$ZAPRET_WAS_ACTIVE" = 1 ] && [ -x /etc/init.d/zapret ]; then /etc/init.d/zapret start >/dev/null 2>&1 || rc=1; fi
    if [ "$ZAPRET2_WAS_ACTIVE" = 1 ] && [ -x /etc/init.d/zapret2 ]; then /etc/init.d/zapret2 start >/dev/null 2>&1 || rc=1; fi
    sleep "${WAIT_AFTER_RESTART:-3}"
    return "$rc"
}

cleanup_ours() {
    kill_running 2>/dev/null || true
    if [ "$FWTYPE" = nftables ] && has nft; then nft delete table inet "$NFT_TABLE" 2>/dev/null || true; fi
    if [ "$FWTYPE" = iptables ] && has iptables; then
        iptables -t mangle -D OUTPUT -j "$IPT_CHAIN" 2>/dev/null || true
        iptables -t mangle -F "$IPT_CHAIN" 2>/dev/null || true
        iptables -t mangle -X "$IPT_CHAIN" 2>/dev/null || true
    fi
}

restore_all() {
    cleanup_ours
    rc=0
    # The preferred rollback is service-level: restore only what we stopped/temporarily changed.
    if ! restart_engine_services; then rc=1; fi
    if [ "$rc" = 0 ]; then ROLLBACK_OK=1; else ROLLBACK_OK=0; fi
    log "restore rc=$rc"
    return "$rc"
}

zapret_test_signal_handler() {
    sig="$1"
    # Stage-specific handlers must not be installed permanently: this dispatcher
    # remains active for the whole interactive session.
    case "${SIGNAL_STAGE:-}" in
        blockcheck)
            blockcheck_signal_handler 2>/dev/null || true
            ;;
        external)
            external_signal_handler 2>/dev/null || true
            ;;
        strategy)
            strategy_signal_handler 2>/dev/null || true
            ;;
        *)
            cleanup_ours 2>/dev/null || true
            rm -f "$RUN/active.main.pid" "$RUN/active.blockcheck.pid" "$RUN/active.external.pid" "$RUN/active.strategy.pid"
            exit 130
            ;;
    esac
}
zapret_test_exit_handler() {
    rc="$?"
    cleanup_ours 2>/dev/null || true
    rm -f "$RUN/active.main.pid" "$RUN/active.blockcheck.pid" "$RUN/active.external.pid" "$RUN/active.strategy.pid"
    exit "$rc"
}
trap 'zapret_test_signal_handler INT' INT
trap 'zapret_test_signal_handler TERM' TERM
trap 'zapret_test_exit_handler' EXIT

