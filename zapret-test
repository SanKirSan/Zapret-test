cmd_blockcheck_engine() {
    engine="$1"
    ensure_default_files; load_config; detect_system; detect_zapret; detect_zapret2; report_init
    if [ -z "$(cat "$STATE/blockcheck.domain" 2>/dev/null || true)" ]; then
        [ -s "$STATE/services.list" ] && set_first_blockcheck_target || select_blockcheck_target || return 1
    fi
    if [ "$engine" = ZAPRET ] && [ -z "${BLOCKCHECK:-}" ]; then say 'zapret/blockcheck.sh: NOT FOUND'; return 1; fi
    if [ "$engine" = ZAPRET2 ] && [ -z "${BLOCKCHECK2:-}" ]; then say 'zapret2/blockcheck2.sh: NOT FOUND'; return 1; fi
    backup_create
    stop_engine_services || { say 'failed to stop installed services'; return 1; }
    run_engine_blockcheck "$engine"
    run_rc=$?
    restore_all || { ROLLBACK_OK=0; say 'CRITICAL: service restore failed'; return 1; }
    [ "$run_rc" -eq 130 ] && { say '[INTERRUPTED] Blockcheck stopped by user.'; finalize_report; return 130; }
    [ "$run_rc" -ne 0 ] && { say "Could not run $engine blockcheck."; return "$run_rc"; }
    finalize_report
    say "Blockcheck results directory: $BLOCKDIR"
    ls -1t "$BLOCKDIR"/blockcheck*.txt 2>/dev/null | head -n 5 || true
    ask_save_blockcheck "blockcheck*.txt"
}

cmd_blockcheck1() { cmd_blockcheck_engine ZAPRET; }
cmd_blockcheck2() { cmd_blockcheck_engine ZAPRET2; }
cmd_blockcheck() {
    ensure_default_files; load_config; detect_system; detect_zapret; detect_zapret2; report_init
    [ -s "$STATE/blockcheck.domain" ] || { [ -s "$STATE/services.list" ] && set_first_blockcheck_target || select_blockcheck_target || return 1; }
    backup_create
    stop_engine_services || { say 'failed to stop installed services'; return 1; }
    any=0
    for e in ZAPRET ZAPRET2; do
        case "$e" in
            ZAPRET) [ -n "${BLOCKCHECK:-}" ] || continue;;
            ZAPRET2) [ -n "${BLOCKCHECK2:-}" ] || continue;;
        esac
        any=1
        run_engine_blockcheck "$e" S
        run_rc=$?
        if [ "$run_rc" -eq 130 ] || [ "$run_rc" -eq 143 ]; then
            interrupted=1
            break
        fi
    done
    [ "$any" = 1 ] || { say 'Neither blockcheck.sh nor blockcheck2.sh was detected.'; return 1; }
    if [ "${interrupted:-0}" = 1 ]; then
        restore_all || { ROLLBACK_OK=0; }
        finalize_report
        return 130
    fi
    restore_all || { ROLLBACK_OK=0; say 'CRITICAL: service restore failed'; return 1; }
    finalize_report
    say "Blockcheck results directory: $BLOCKDIR"
    ls -1t "$BLOCKDIR"/blockcheck*.txt 2>/dev/null | head -n 10 || true
    ask_save_blockcheck "blockcheck*.txt"
}

engines_to_test() {
    case "${ENGINE_SELECTION:-AUTO}" in
        ZAPRET) [ -n "${NFQWS:-}" ] && echo ZAPRET ;;
        ZAPRET2) [ -n "${NFQWS2:-}" ] && echo ZAPRET2 ;;
        *)
            [ -n "${NFQWS:-}" ] && echo ZAPRET
            [ -n "${NFQWS2:-}" ] && echo ZAPRET2
            ;;
    esac
}

cmd_test() {
    ensure_default_files; detect_system; detect_zapret; detect_zapret2; report_init; [ -f "$STATE/services.list" ] || select_services_interactive
    DEEP_DIAGNOSTICS=0
    : > "$RUN/strategy-results"
    rm -f "$STATE/blockcheck.domain" "$STATE/blockcheck.service"
    baseline
    backup_create; stop_engine_services || die 'failed to stop installed services'
    set_first_blockcheck_target || { say "$(t NO_VALID_BC_DOMAINS)"; return 1; }
    test_interrupted=0
    for e in $(engines_to_test); do
        db="$BLOCKDIR/${e}.db"
        rm -f "$db" "$BLOCKDIR/${e}.candidates"
        run_engine_blockcheck "$e" S
        run_rc=$?
        if [ "$run_rc" -eq 130 ] || [ "$run_rc" -eq 143 ]; then
            test_interrupted=1
            break
        fi
        [ "$run_rc" -eq 0 ] || continue
        [ -s "$db" ] || continue
        run_strategy_tests "$e" "$db" "${ATTEMPTS:-3}" || true
    done
    if ! restore_all; then say 'CRITICAL: rollback failed; stopping further processing'; ROLLBACK_OK=0; fi
    if [ "$test_interrupted" = 1 ]; then
        say "[$(t TAG_STOP)] Test chain interrupted; candidate verification was not started on partial blockcheck data."
        finalize_report
        return 130
    fi
    finalize_report
    say "Report: $REPORT_TXT"
    say "JSON:   $REPORT_JSON"
}

