run_external_command() {
    name="$1"; label="$2"; shift 2
    [ "${ENABLE_EXTERNAL_TESTS:-1}" = 1 ] || { say '[SKIP] External tests disabled.'; return 0; }
    ts="$(date '+%Y%m%d-%H%M%S')"
    safe="$(printf '%s' "$name" | tr -c 'A-Za-z0-9_.-' '_')"
    tmp="$EXTERNAL_DIR/.${safe}-${ts}.txt"
    fifo="$RUN/external-$$.fifo"
    rcfile="$RUN/external-$$.rc"
    rm -f "$fifo" "$rcfile"
    : > "$tmp"
    mkfifo "$fifo" 2>/dev/null || { say "[$(t TAG_FAIL)] Cannot create FIFO: $fifo"; return 1; }
    say ''
    say '============================================================'
    say " $label"
    say '============================================================'
    say "zapret-test      : $VERSION"
    say "$(t STARTED)          : $(date)"
    say '------------------------------------------------------------'
    t LIVE_OUTPUT
    tee "$tmp" < "$fifo" & tee_pid=$!
    start_epoch="$(date +%s)"
    if has setsid; then
        setsid sh -c 'fifo="$1"; rcfile="$2"; shift 2; "$@" >"$fifo" 2>&1; rc=$?; printf "%s\n" "$rc" >"$rcfile"; exit "$rc"' sh "$fifo" "$rcfile" "$@" &
        isolated=1
    else
        ( "$@" >"$fifo" 2>&1; rc=$?; printf '%s\n' "$rc" >"$rcfile"; exit "$rc" ) &
        isolated=0
    fi
    pid=$!
    pgid="$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ' || true)"
    printf '%s|%s|%s\n' "$pid" "$pgid" "$isolated" > "$RUN/active.external.pid"
    EXTERNAL_RUNNING_PID="$pid"; EXTERNAL_RUNNING_LOG="$tmp"; EXTERNAL_RUNNING_PGID="$pgid"; EXTERNAL_RUNNING_ISOLATED="$isolated"
    interrupted=0
    SIGNAL_STAGE=external
    EXTERNAL_TEE_PID="${tee_pid:-}"
    external_signal_handler() {
        interrupted=1
        if [ -n "${EXTERNAL_TEE_PID:-}" ]; then
            kill_tree "$EXTERNAL_TEE_PID" >/dev/null 2>&1 || true
            kill -KILL "$EXTERNAL_TEE_PID" 2>/dev/null || true
        fi
        kill_active_record "$RUN/active.external.pid" >/dev/null 2>&1 || true
        printf "%s\n" 130 > "$rcfile"
    }
    heartbeat=0
    while [ ! -f "$rcfile" ]; do
        if ! kill -0 "$pid" 2>/dev/null; then printf '125\n' > "$rcfile"; break; fi
        sleep 1; heartbeat=$((heartbeat+1))
    done
    wait "$pid" 2>/dev/null || true
    wait "$tee_pid" 2>/dev/null || true
    rc="$(cat "$rcfile" 2>/dev/null || echo 125)"
    case "$rc" in ''|*[!0-9]*) rc=125;; esac
    end_epoch="$(date +%s)"; elapsed=$((end_epoch-start_epoch))
    status=COMPLETED
    [ "$rc" -eq 130 ] && status=INTERRUPTED
    [ "$interrupted" -eq 1 ] && status=INTERRUPTED && rc=130
    [ "$rc" -ne 0 ] && [ "$status" = COMPLETED ] && status=EXITED_WITH_ERROR
    SIGNAL_STAGE=""
    rm -f "$RUN/active.external.pid" "$fifo" "$rcfile"
    EXTERNAL_RUNNING_PID=""; EXTERNAL_RUNNING_LOG=""; EXTERNAL_RUNNING_PGID=""; EXTERNAL_RUNNING_ISOLATED=0
    say '------------------------------------------------------------'
    say "[ RESULT ] $([ "${LANG_MODE:-RU}" = RU ] && echo "Результат" || echo "Result"): $status | Exit: $rc | Duration: $(printf '%02d:%02d:%02d' $((elapsed/3600)) $(((elapsed%3600)/60)) $((elapsed%60)))"
    external_mark "$name" "$status" not_saved
    rm -f "$tmp"
    say '============================================================'
    return "$rc"
}

