main() {
    need_root
    init_dirs
    ensure_default_files
    load_config
    if [ "$#" -eq 0 ]; then
        printf '%s\n' "$$" > "$RUN/active.main.pid"
        interactive_menu
        rm -f "$RUN/active.main.pid"
        return $?
    fi
    C="$1"
    case "$C" in version|--version|help|--help|-h|stop) ;; *) sync_domain_lists ;; esac
    if [ "$C" != stop ] && [ "$C" != version ] && [ "$C" != --version ] && [ "$C" != help ] && [ "$C" != --help ] && [ "$C" != -h ]; then
        printf '%s\n' "$$" > "$RUN/active.main.pid"
    fi
    case "$C" in
      requirements) requirements_status;;
      detect) cmd_detect=1; show_detect;;
      services) cmd_services;;
      baseline) cmd_baseline;;
      blockcheck) cmd_blockcheck;;
      blockcheck1) cmd_blockcheck1;;
      blockcheck2) cmd_blockcheck2;;
      quick) cmd_quick;;
      full) cmd_full;;
      auto) cmd_auto;;
      debug) cmd_debug;;
      restore) cmd_restore;;
      report) cmd_report;;
      apply) shift; [ $# -eq 1 ] || die 'apply needs FILE'; cmd_apply "$1";;
      custom) cmd_custom;;
      external) cmd_external;;
      stop) stop_active_test;;
      version|--version) printf "%s %s\n" "$NAME" "$VERSION";;
      help|--help|-h) usage;;
      *) die "unknown command: $C";;
    esac
}

