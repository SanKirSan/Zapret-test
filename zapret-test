baseline_worker() {
    : > "$STATE/baseline"
    : > "$RUN/baseline-progress"
    progress_n=0
    progress_total=0
    _seen_domains=''
    while IFS= read -r _svc; do
        [ -n "$_svc" ] || continue
        _rec="$(service_record "$_svc")"
        IFS='|' read -r _ _desc _domains _tcp _udp _htt _https _quic <<EOF2
$_rec
EOF2
        for _d in $_domains; do
            [ -n "$_d" ] || continue
            case " $_seen_domains " in *" $_d "*) continue;; esac
            _seen_domains="$_seen_domains $_d"
            progress_total=$((progress_total+1))
        done
    done < "$STATE/services.list"
    {
      echo '=================================================='
      echo 'BASELINE'
      echo '=================================================='
    } >> "$REPORT_TXT"
    while IFS= read -r s; do
        rec="$(service_record "$s")"
        IFS='|' read -r _ desc domains tcp udp htt https quic <<EOF2
$rec
EOF2
        echo "[$s]" >> "$REPORT_TXT"
        for d in $domains; do
            progress_n=$((progress_n+1))
            printf '%s|%s|%s|%s\n' "$progress_n" "$progress_total" "$d" "DNS" > "$RUN/baseline-progress"
            r="$(dns_integrity_probe "$d")"; echo "$s|$d|DNS|$r" >> "$STATE/baseline"; printf '%s|%s|%s|%s\n' "$progress_n" "$progress_total" "$d" "DNS" > "$RUN/baseline-progress"
            printf '  %-28s DNS=%s\n' "$d" "$r" >> "$REPORT_TXT"
            dnskind="${r%%|*}"
            if [ "$dnskind" != DNS_SYNTHETIC ] && [ "$dnskind" != DNS_FAILURE ]; then
                [ "$htt" = 1 ] && { printf '%s|%s|%s|%s\n' "$progress_n" "$progress_total" "$d" "HTTP" > "$RUN/baseline-progress"; r="$(curl_probe "http://$d" "")"; echo "$s|$d|HTTP|$r" >> "$STATE/baseline"; printf '  %-28s HTTP=%s\n' "$d" "$r" >> "$REPORT_TXT"; }
                [ "$https" = 1 ] && { printf '%s|%s|%s|%s\n' "$progress_n" "$progress_total" "$d" "HTTPS" > "$RUN/baseline-progress"; r="$(curl_probe "https://$d" "")"; echo "$s|$d|HTTPS|$r" >> "$STATE/baseline"; printf '  %-28s HTTPS=%s\n' "$d" "$r" >> "$REPORT_TXT"; }
            fi
            [ "$ENABLE_HTTP3" = 1 ] && [ "$quic" = 1 ] && {
                if http3_capable; then r="$(curl_probe "https://$d" "--http3-only")"; else r='2|UNAVAILABLE|0|NA|'; fi
                echo "$s|$d|HTTP3|$r" >> "$STATE/baseline"
            }
        done
    done < "$STATE/services.list"
}

print_baseline_results() {
    say ''
    say '============================================================'
    say " $( [ "${LANG_MODE:-RU}" = RU ] && echo 'РЕЗУЛЬТАТ БАЗОВОЙ ПРОВЕРКИ' || echo 'BASELINE RESULTS' )"
    say '============================================================'
    total=0; ok=0; partial=0; bad=0
    if [ ! -s "$STATE/baseline" ]; then
        say "  $(t NO_DATA_VIEW)"
        say '============================================================'
        return 0
    fi

    baseline_domain_state() {
        _bs="$1"; _bd="$2"
        _dnsr="$(grep -F "$_bs|$_bd|DNS|" "$STATE/baseline" 2>/dev/null | tail -n1 | cut -d'|' -f4-)"
        _httpsr="$(grep -F "$_bs|$_bd|HTTPS|" "$STATE/baseline" 2>/dev/null | tail -n1 | cut -d'|' -f4-)"
        _httpr="$(grep -F "$_bs|$_bd|HTTP|" "$STATE/baseline" 2>/dev/null | tail -n1 | cut -d'|' -f4-)"
        _dnskind="${_dnsr%%|*}"; _dnsrest="${_dnsr#*|}"; _dnsip="${_dnsrest%%|*}"; _dnsup="$(printf '%s' "$_dnsrest" | cut -d'|' -f2)"; _dnsdoh="$(printf '%s' "$_dnsrest" | cut -d'|' -f3)"
        case "$_dnskind" in
            PASS)
                case "$_httpsr" in
                    *'|PASS|'*) printf 'PASS|';;
                    *'|TIMEOUT|'*) printf 'TIMEOUT|';;
                    *'|TCP_FAILURE|'*) printf 'TCP_FAILURE|';;
                    *'|TLS_FAILURE|'*) printf 'TLS_FAILURE|';;
                    *'|HTTP_FAILURE|'*) printf 'HTTP_FAILURE|';;
                    *)
                        case "$_httpr" in
                            *'|PASS|'*) printf 'PASS|';;
                            *'|TIMEOUT|'*) printf 'TIMEOUT|';;
                            *'|TCP_FAILURE|'*) printf 'TCP_FAILURE|';;
                            *'|DNS_FAILURE|'*) printf 'DNS_FAILURE|';;
                            *'|HTTP_FAILURE|'*) printf 'HTTP_FAILURE|';;
                            *) printf 'NO_DATA|';;
                        esac;;
                esac;;
            DNS_FAILURE) printf 'DNS_FAILURE|';;
            DNS_MISMATCH) printf 'DNS_MISMATCH|%s|%s|%s' "$_dnsip" "$_dnsup" "$_dnsdoh";;
            DNS_SYNTHETIC) printf 'DNS_SYNTHETIC|%s|%s|%s' "$_dnsip" "$_dnsup" "$_dnsdoh";;
            *) printf 'NO_DATA|';;
        esac
    }

    print_domain_line() {
        _svc="$1"; _dom="$2"; _tree="$3"; _last="$4"
        _st="$(baseline_domain_state "$_svc" "$_dom")"
        _kind="${_st%%|*}"; _detail_extra="${_st#*|}"
        case "$_kind" in
            PASS) _mark='✓'; _detail=$( [ "${LANG_MODE:-RU}" = RU ] && echo 'РАБОТАЕТ' || echo 'WORKS' ); _badge="$(badge "$C_BG_GREEN" "$C_FG_BLACK" " $( [ "${LANG_MODE:-RU}" = RU ] && echo "РАБОТАЕТ" || echo "WORKS" ) ")";;
            DNS_FAILURE) _mark='✗'; _detail=$( [ "${LANG_MODE:-RU}" = RU ] && echo 'ЗАБЛОКИРОВАНО: DNS' || echo 'BLOCKED: DNS' ); _badge="$(badge "$C_BG_RED" "$C_FG_WHITE" " $( [ "${LANG_MODE:-RU}" = RU ] && echo "ЗАБЛОКИРОВАНО" || echo "BLOCKED" ) ")";;
            DNS_SYNTHETIC) _mark='✗'; _detail="$( [ "${LANG_MODE:-RU}" = RU ] && echo 'ПЕРЕХВАТ DNS' || echo 'DNS INTERCEPTED' ) ($_detail_extra)"; _badge="$(badge "$C_BG_RED" "$C_FG_WHITE" " $( [ "${LANG_MODE:-RU}" = RU ] && echo "ЗАБЛОКИРОВАНО" || echo "BLOCKED" ) ")";;
            DNS_MISMATCH) _mark='~'; _detail="$( [ "${LANG_MODE:-RU}" = RU ] && echo 'DNS НЕ СОВПАДАЕТ: локальный/upstream/DoH' || echo 'DNS MISMATCH: local/upstream/DoH' )=$_detail_extra"; _badge="$(badge "$C_BG_YELLOW" "$C_FG_BLACK" " $( [ "${LANG_MODE:-RU}" = RU ] && echo "ПРОВЕРИТЬ" || echo "CHECK" ) ")";;
            TCP_FAILURE) _mark='✗'; _detail=$( [ "${LANG_MODE:-RU}" = RU ] && echo 'ЗАБЛОКИРОВАНО: TCP' || echo 'BLOCKED: TCP' ); _badge="$(badge "$C_BG_RED" "$C_FG_WHITE" " $( [ "${LANG_MODE:-RU}" = RU ] && echo "ЗАБЛОКИРОВАНО" || echo "BLOCKED" ) ")";;
            TLS_FAILURE) _mark='✗'; _detail=$( [ "${LANG_MODE:-RU}" = RU ] && echo 'ЗАБЛОКИРОВАНО: TLS' || echo 'BLOCKED: TLS' ); _badge="$(badge "$C_BG_RED" "$C_FG_WHITE" " $( [ "${LANG_MODE:-RU}" = RU ] && echo "ЗАБЛОКИРОВАНО" || echo "BLOCKED" ) ")";;
            TIMEOUT) _mark='✗'; _detail=$( [ "${LANG_MODE:-RU}" = RU ] && echo 'ТАЙМ-АУТ' || echo 'TIMEOUT' ); _badge="$(badge "$C_BG_RED" "$C_FG_WHITE" " $( [ "${LANG_MODE:-RU}" = RU ] && echo "ТАЙМ-АУТ" || echo "TIMEOUT" ) ")";;
            HTTP_FAILURE) _mark='✗'; _detail=$( [ "${LANG_MODE:-RU}" = RU ] && echo 'ОШИБКА HTTP' || echo 'HTTP FAILED' ); _badge="$(badge "$C_BG_RED" "$C_FG_WHITE" " $( [ "${LANG_MODE:-RU}" = RU ] && echo "ЗАБЛОКИРОВАНО" || echo "BLOCKED" ) ")";;
            *) _mark='~'; _detail=$( [ "${LANG_MODE:-RU}" = RU ] && echo 'НЕТ ДАННЫХ' || echo 'NO DATA' ); _badge="$(badge "$C_BG_YELLOW" "$C_FG_BLACK" " $( [ "${LANG_MODE:-RU}" = RU ] && echo "НЕТ ДАННЫХ" || echo "NO DATA" ) ")";;
        esac
        printf '%s %s  %s %s\n' "$_tree" "$_dom" "$_badge" "$_detail"
        case "$_kind" in
            PASS) ok=$((ok+1));;
            DNS_FAILURE|DNS_SYNTHETIC|TCP_FAILURE|TLS_FAILURE|TIMEOUT|HTTP_FAILURE) bad=$((bad+1));;
            DNS_MISMATCH) partial=$((partial+1));;
            *) partial=$((partial+1));;
        esac
        total=$((total+1))
        echo "$_svc|$_dom|RESULT|$_kind|$_detail" >> "$REPORT_TXT"
    }

    while IFS= read -r s; do
        [ -n "$s" ] || continue
        rec="$(service_record "$s")"
        IFS='|' read -r _ desc domains tcp udp htt https quic groups <<EOF2
$rec
EOF2
        if [ -n "${groups:-}" ]; then
            # NVIDIA and other grouped services are rendered exactly like every other
            # service: one flat domain list with no nested group/sub-list formatting.
            say "$s"
            _count=0; _idx=0
            for d in $domains; do [ -n "$d" ] && _count=$((_count+1)); done
            for d in $domains; do
                [ -n "$d" ] || continue
                _idx=$((_idx+1)); _last=0; [ "$_idx" -eq "$_count" ] && _last=1
                if [ "$_last" -eq 1 ]; then tree='└─'; else tree='├─'; fi
                print_domain_line "$s" "$d" "$tree" "$_last"
            done
        else
            say "$s"
            _count=0; _idx=0
            for d in $domains; do [ -n "$d" ] && _count=$((_count+1)); done
            for d in $domains; do
                [ -n "$d" ] || continue
                _idx=$((_idx+1)); _last=0; [ "$_idx" -eq "$_count" ] && _last=1
                if [ "$_last" -eq 1 ]; then tree='└─'; else tree='├─'; fi
                print_domain_line "$s" "$d" "$tree" "$_last"
            done
        fi
        say ''
    done < "$STATE/services.list"
    say '------------------------------------------------------------'
