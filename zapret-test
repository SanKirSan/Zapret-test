        /^SERVICE=/{cur=$0; sub(/^SERVICE=/,"",cur); gsub(/^"|"$/,"",cur); in_s=(cur==svc); next}
        in_s && /^PRIMARY_DOMAIN=/{x=$0; sub(/^PRIMARY_DOMAIN=/,"",x); gsub(/^"|"$/,"",x); print x; exit}
    ' "$SERVICE_DB" 2>/dev/null
}

