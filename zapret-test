external_dns_transport_integrity() {
    external_check_dependencies 'DNS transport / synthetic-IP integrity' curl dig jq openssl || return 0
    run_native_test dns-transport 'DNS transport / configured router resolvers / 127.0.0.42' sh -c '
        DNS_DOMAINS="${DNS_TEST_DOMAINS:-youtube.com discord.com rutracker.org openwrt.org github.com}"
        EXPECTED_SYNTH="${DNS_SYNTH_IP:-127.0.0.42}"
        RESOLV_FILE="${DNS_CONFIG_FILE:-/tmp/resolv.conf.d/resolv.conf.auto}"
        [ -s "$RESOLV_FILE" ] || RESOLV_FILE="/etc/resolv.conf"
        LOCAL_DNS="$(awk "/^nameserver /{print \$2}" /etc/resolv.conf 2>/dev/null | head -n5 | tr "\n" " ")"
        CONFIG_DNS="$(awk "/^nameserver /{print \$2}" "$RESOLV_FILE" 2>/dev/null | head -n5 | tr "\n" " ")"
        [ -n "$CONFIG_DNS" ] || CONFIG_DNS="$LOCAL_DNS"
        echo "Router resolver config: $RESOLV_FILE"
        echo "Local resolver(s): ${LOCAL_DNS:-UNAVAILABLE}"
        echo "Configured upstream resolver(s): ${CONFIG_DNS:-UNAVAILABLE}"
        echo "127.0.0.42 / 198.18.0.0/15 are treated as synthetic DNS interception markers."
        echo
        dot=UNAVAILABLE
        if printf "" | openssl s_client -connect 1.1.1.1:853 -servername cloudflare-dns.com -brief >/tmp/dot.$$ 2>&1; then dot=TLS_OK; elif grep -q "CONNECTION ESTABLISHED" /tmp/dot.$$ 2>/dev/null; then dot=TLS_OK; else dot=TLS_FAIL; fi
        rm -f /tmp/dot.$$
        printf "%-24s %-18s %-18s %-18s %-12s %-12s\n" DOMAIN LOCAL_UDP CONFIGURED_UDP DOH SYNTH DOT_TLS
        printf "%-24s %-18s %-18s %-18s %-12s %-12s\n" ------------------------ ------------------ ------------------ ------------------ ------------ ------------
        for d in $DNS_DOMAINS; do
            local="$(dig @127.0.0.1 +time=2 +tries=1 +short "$d" A 2>/dev/null | grep -E "^[0-9.]+$" | head -n1 || true)"
            upstream=""
            for r in $CONFIG_DNS; do
                case "$r" in 127.0.0.1|::1) continue;; esac
                upstream="$(dig @"$r" +time=2 +tries=1 +short "$d" A 2>/dev/null | grep -E "^[0-9.]+$" | head -n1 || true)"
                [ -n "$upstream" ] && break
            done
            doh="$(curl -4 -fsS --connect-timeout 5 --max-time 8 -H "accept: application/dns-json" "https://cloudflare-dns.com/dns-query?name=$d&type=A" 2>/dev/null | jq -r ".Answer[]?.data" 2>/dev/null | grep -E "^[0-9.]+$" | head -n1 || true)"
            synth=NO; case "$local" in "$EXPECTED_SYNTH"|198.18.*|198.19.*) synth=YES;; esac
            printf "%-24s %-18s %-18s %-18s %-12s %-12s\n" "$d" "${local:-FAIL}" "${upstream:-FAIL}" "${doh:-FAIL}" "$synth" "$dot"
        done
        echo
        echo "DoT result is TLS transport reachability only; no full DNS-over-TLS query is claimed without a DoT client."
    '
}

external_nvidia_detailed() {
    external_check_dependencies 'NVIDIA detailed diagnostics' curl dig openssl nc || return 0
    rec="$(service_record NVIDIA)"
    IFS='|' read -r _ _ _ _ _ _ _ _ groups <<EOF2
$rec
EOF2
    [ -n "${groups:-}" ] || { say '[ERROR] NVIDIA groups are not configured.'; return 1; }
    run_native_test nvidia-detailed "$(t NVIDIA_DETAIL)" sh -c '
        groups="$1"
        resolve_a() { dig +short "$1" A 2>/dev/null | grep -E "^[0-9.]+$" | head -n1; }
        check_metrics() {
            d="$1"
            ip=$(resolve_a "$d")
            [ -n "$ip" ] || { printf "|0|0|0|000"; return; }
            tcp=0; nc -z -w 3 "$ip" 443 >/dev/null 2>&1 && tcp=1
            tls=0; tlsout=$(printf "" | openssl s_client -connect "$d:443" -servername "$d" -brief 2>&1 || true); echo "$tlsout" | grep -Eq "Protocol[^:]*:[[:space:]]*TLS|Protocol.*TLSv1" && tls=1
            code=$(curl -4 -sS -o /dev/null --connect-timeout 5 --max-time 10 -w "%{http_code}" "https://$d" 2>/dev/null || true); [ -n "$code" ] || code=000
            http=0; case "$code" in 2*|3*|4*|5*) http=1;; esac
            printf "%s|%s|%s|%s|%s" "$ip" "$tcp" "$tls" "$http" "$code"
        }
        title() { case "$1" in "Telemetry / Analytics") echo "Telemetry";; "CDN / Content") echo "CDN";; *) echo "$1";; esac; }
        aggregate() {
            name="$1"; doms="$2"; total=0; dns=0; tcp=0; tls=0; http=0; first_ip=""; first_code=""
            old="$IFS"; IFS=" "; set -- $doms
            for d in "$@"; do
                [ -n "$d" ] || continue; total=$((total+1)); m=$(check_metrics "$d"); ip=$(printf "%s" "$m" | cut -d"|" -f1); t=$(printf "%s" "$m" | cut -d"|" -f2); l=$(printf "%s" "$m" | cut -d"|" -f3); h=$(printf "%s" "$m" | cut -d"|" -f4); c=$(printf "%s" "$m" | cut -d"|" -f5); [ -n "$ip" ] && dns=$((dns+1)); [ "$t" = 1 ] && tcp=$((tcp+1)); [ "$l" = 1 ] && tls=$((tls+1)); [ "$h" = 1 ] && http=$((http+1)); [ -n "$first_ip" ] || first_ip="$ip"; [ -n "$first_code" ] || first_code="$c"
            done
            IFS="$old"; [ "$dns" = "$total" ] && dm="✓" || dm="✗"; [ "$tcp" = "$total" ] && tm="✓" || tm="✗"; [ "$tls" = "$total" ] && lm="✓" || lm="✗"; [ "$http" = "$total" ] && hm="✓" || hm="✗"
            echo "$(title "$name")"; if [ "$dm" = "✓" ] && [ -n "$first_ip" ]; then echo "├─ DNS       ✓  $first_ip"; else echo "├─ DNS       ✗"; fi; echo "├─ TCP 443   $tm"; echo "├─ TLS       $lm"; if [ "$hm" = "✓" ]; then echo "└─ HTTPS     ✓  HTTP $first_code"; else echo "└─ HTTPS     ✗"; fi
        }
        listed() {
            name="$1"; doms="$2"; echo "$(title "$name")"; old="$IFS"; IFS=" "; set -- $doms; total="$#"; idx=0
            for d in "$@"; do [ -n "$d" ] || continue; idx=$((idx+1)); m=$(check_metrics "$d"); ip=$(printf "%s" "$m" | cut -d"|" -f1); h=$(printf "%s" "$m" | cut -d"|" -f4); [ "$h" = 1 ] && mark="✓" || mark="✗ BLOCKED"; [ "$idx" = "$total" ] && br="└─" || br="├─"; printf "%s %-27s %s\n" "$br" "$d" "$mark"; done; IFS="$old"
        }
        old="$IFS"; IFS=";"; first=1
        for grp in $groups; do
            [ -n "$grp" ] || continue; name="${grp%%::*}"; doms="${grp#*::}"; [ "$first" = 1 ] || echo
            case "$name" in "NVIDIA App"|"Drivers"|"Authentication") aggregate "$name" "$doms";; *) listed "$name" "$doms";; esac; first=0
        done
        IFS="$old"
    ' sh "$groups"
}

