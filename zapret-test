select_services_interactive() {
    ensure_default_files
    clear 2>/dev/null || true
    i=1
    : > "$STATE/services.list"
    : > "$STATE/service-menu"
    # A new service selection starts a new test context; never reuse a previous blockcheck target.
    rm -f "$STATE/blockcheck.domain" "$STATE/blockcheck.service"
    say '=============================================='
    say " $(t SELECT_PROFILE)"
    say '=============================================='
    menu_file="$RUN/service-menu-source"
    parse_services > "$menu_file"
    while IFS='|' read -r s d dom tcp udp ht hts q groups; do
        [ -n "$s" ] || continue
        printf '[%d] %s\n' "$i" "$s"
        echo "$i|$s" >> "$STATE/service-menu"
        i=$((i+1))
    done < "$menu_file"
    if [ "${LANG_MODE:-RU}" = RU ]; then say '[A] Все сервисы'; say '[C] Поиск по ключевому слову'; else say '[A] All services'; say '[C] Search by keyword'; fi
    say "[0] $(t EXIT)"
    t SELECT_SERVICES
    read answer || answer=''
    case "$answer" in
        0) rm -f "$STATE/blockcheck.domain" "$STATE/blockcheck.service"; return 1;;
        c|C)
            say ''
            t KEYWORD_INFO
            say ''
            t KEYWORD_SEARCH
            say '------------------------------------------------------------'
            t KEYWORD_PROMPT
            read keyword || keyword=''
            discover_keyword_service "$keyword" || return 1
            ;;
        all|ALL|All|a|A)
            awk -F'|' '{print $2}' "$STATE/service-menu" > "$STATE/services.list"
            ;;
        *)
            oldIFS=$IFS
            IFS=','
            for x in $answer; do
                x=$(printf '%s' "$x" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
                awk -F'|' -v n="$x" '$1==n{print $2}' "$STATE/service-menu" >> "$STATE/services.list"
            done
            IFS=$oldIFS
            ;;
    esac
    if [ ! -s "$STATE/services.list" ]; then
        t NO_SERVICES
        return 1
    fi
    # Selected services are shown once in the subsequent baseline preparation block.
}

discover_keyword_service() {
    keyword="$1"
    keyword=$(printf '%s' "$keyword" | tr '[:upper:]' '[:lower:]' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
    case "$keyword" in
        ''|*[!a-z0-9._-]*) t INVALID; return 1 ;;
    esac
    [ "${#keyword}" -ge 3 ] || { t KEYWORD_TOO_SHORT; return 1; }
    domains_file="$STATE/keyword-domains"
    : > "$domains_file"
    case "$keyword" in
        nvidia|nvidia.com)
            rec="$(parse_services | grep -F 'NVIDIA|' | head -n1)"
            printf '%s\n' "$rec" | awk -F'|' '{print $3}' | tr ' ' '\n' >> "$domains_file"
            ;;
    esac
    if has curl && has jq; then
        search_json="$(curl -fsSL --connect-timeout 5 --max-time 20 --get \
            --data-urlencode "q=%$keyword%" --data-urlencode 'output=json' 'https://crt.sh/' 2>/dev/null || true)"
        if [ -n "$search_json" ]; then
            printf '%s' "$search_json" | jq -r '.[]?.name_value // empty' 2>/dev/null \
                | tr '\r' '\n' \
                | sed 's/^\*\.//; s/^[[:space:]]*//; s/[[:space:]]*$//; /^$/d' \
                | tr '[:upper:]' '[:lower:]' \
                | grep -E '(^|\.)[a-z0-9][a-z0-9.-]*\.[a-z]{2,}$' \
                | grep -F "$keyword" \
                | sort -u >> "$domains_file" || true
        fi
    fi
    tmpfile="$domains_file.tmp"
    sort -u "$domains_file" 2>/dev/null | head -n 100 > "$tmpfile" 2>/dev/null || true
    mv "$tmpfile" "$domains_file" 2>/dev/null || true
    count="$(wc -l < "$domains_file" 2>/dev/null | tr -d ' ')"
    [ -n "$count" ] || count=0
    printf '%s%d\n' "$(t KEYWORD_FOUND)" "$count"
    [ "$count" -gt 0 ] || { t KEYWORD_NORESULTS; return 1; }
    say '------------------------------------------------------------'
    cat "$domains_file"
    say '------------------------------------------------------------'
    t KEYWORD_NOTE
    svc="Keyword:$keyword"
    {
        printf 'SERVICE=%s\n' "$svc"
        printf 'DESCRIPTION=Keyword search result\n'
        printf 'DOMAINS="%s"\n' "$(tr '\n' ' ' < "$domains_file" | sed 's/[[:space:]]*$//')"
        printf 'TCP_PORTS="80 443"\nUDP_PORTS="443"\nHTTP_TEST=1\nHTTPS_TEST=1\nQUIC_TEST=1\n\n'
    } > "$RUNTIME_SERVICES.tmp"
    mv "$RUNTIME_SERVICES.tmp" "$RUNTIME_SERVICES"
    printf '%s\n' "$svc" > "$STATE/services.list"
}

valid_domain() {
    _vd="$1"
    case "$_vd" in
        ''|*'://'*|*'/'*|*':'*|*' '*|.*|*.|*..*) return 1 ;;
    esac
    printf '%s' "$_vd" | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$'
}

validate_domains() {
    _invalid=""
    for _vd in $1; do
        _nd=$(printf '%s' "$_vd" | tr '[:upper:]' '[:lower:]')
        if ! valid_domain "$_nd"; then
            _invalid="$_invalid $_vd"
        fi
    done
    if [ -n "$_invalid" ]; then
        say "$(t DOMAIN_INVALID)"
        say "$(t DOMAIN_INVALID_LIST)$_invalid"
        return 1
    fi
    return 0
}

normalize_domains() {
    _out=""
    for _vd in $1; do
        _nd=$(printf '%s' "$_vd" | tr '[:upper:]' '[:lower:]')
        case " $_out " in
            *" $_nd "*) ;;
            *) _out="$_out $_nd";;
        esac
    done
    printf '%s\n' "$_out" | sed 's/^ *//; s/  */ /g'
}

get_custom_record_block() {
    want="$1"
    awk -v want="$want" '
      /^SERVICE=/ {
        cur=$0; sub(/^SERVICE=/,"",cur); gsub(/^"|"$/,"",cur)
        in_block=(cur==want)
        if (in_block) print
        next
      }
      in_block {print}
    ' "$CUSTOM_SERVICES" 2>/dev/null
}

custom_service_exists() {
    get_custom_record_block "$1" | grep -q '^SERVICE='
}

list_custom_services() {
    i=1
    : > "$RUN/custom-menu"
    parse_services > "$RUN/custom-menu-source"
    while IFS='|' read -r s d dom tcp udp ht hts q groups; do
        [ -n "$s" ] || continue
        case "$s" in Keyword:*) continue;; esac
        if custom_service_exists "$s"; then
            printf '%d|%s\n' "$i" "$s" >> "$RUN/custom-menu"
            printf '[%d] %s\n' "$i" "$s"
            i=$((i+1))
        fi
    done < "$RUN/custom-menu-source"
}

read_custom_field() {
    get_custom_record_block "$1" | sed -n "s/^$2=\"\(.*\)\"$/\1/p"
}

write_custom_record() {
    service="$1"; domains="$2"; tcp="$3"; udp="$4"
    tmp="$CUSTOM_SERVICES.tmp.$$"
    awk -v want="$service" '
      /^SERVICE=/ {
        cur=$0; sub(/^SERVICE=/,"",cur); gsub(/^"|"$/,"",cur)
        if (cur==want) { skip=1; next }
        if (skip) skip=0
      }
      !skip {print}
    ' "$CUSTOM_SERVICES" > "$tmp"
    cat >> "$tmp" <<EOF2

SERVICE=$service
DESCRIPTION=Custom service
DOMAINS="$domains"
TCP_PORTS="$tcp"
UDP_PORTS="$udp"
HTTP_TEST=1
HTTPS_TEST=1
QUIC_TEST=1
EOF2
    mv "$tmp" "$CUSTOM_SERVICES"
}

edit_custom_service() {
    svc="$1"
    old_d="$(read_custom_field "$svc" DOMAINS)"
    old_tcp="$(read_custom_field "$svc" TCP_PORTS)"
    old_udp="$(read_custom_field "$svc" UDP_PORTS)"
    while :; do
        if [ "${LANG_MODE:-RU}" = RU ]; then printf 'Домены [%s]: ' "$old_d"; else printf 'Domains [%s]: ' "$old_d"; fi; read d || d="$old_d"
        [ -n "$d" ] || d="$old_d"
        validate_domains "$d" && break
        t EDIT_DOMAIN_ERROR
    done
    norm="$(normalize_domains "$d")"
    [ -n "$norm" ] || { t DOMAIN_INVALID; return 1; }
    if [ "${LANG_MODE:-RU}" = RU ]; then printf 'TCP-порты [%s]: ' "${old_tcp:-443}"; else printf 'TCP ports [%s]: ' "${old_tcp:-443}"; fi; read tcp || tcp="$old_tcp"; [ -n "$tcp" ] || tcp=443
    if [ "${LANG_MODE:-RU}" = RU ]; then printf 'UDP-порты [%s]: ' "${old_udp:-443}"; else printf 'UDP ports [%s]: ' "${old_udp:-443}"; fi; read udp || udp="$old_udp"; [ -n "$udp" ] || udp=443
    write_custom_record "$svc" "$norm" "$tcp" "$udp"
    say "$(t EDITED): $svc"
}

delete_custom_service() {
    svc="$1"
    printf "$(t DELETE_CONFIRM)" "$svc"
    read ans || ans=n
    case "$ans" in
        y|Y)
            tmp="$CUSTOM_SERVICES.tmp.$$"
            awk -v want="$svc" '
              /^SERVICE=/ {
                cur=$0; sub(/^SERVICE=/,"",cur); gsub(/^"|"$/,"",cur)
                if (cur==want) {skip=1; next}
                if (skip) skip=0
              }
              !skip {print}
            ' "$CUSTOM_SERVICES" > "$tmp"
            mv "$tmp" "$CUSTOM_SERVICES"
            say "$(t DELETED): $svc"
            ;;
        *) t DELETE_CANCEL ;;
    esac
}

manage_custom_services() {
    ensure_default_files
    while :; do
        clear 2>/dev/null || true
        say '=============================================='
        say " $(t MANAGE_CUSTOM)"
        say '=============================================='
        list_custom_services
        if [ ! -s "$RUN/custom-menu" ]; then
            say "$(t NO_CUSTOM)"
            say "[0] $(t EXIT)"
            ui_pause
            return 0
        fi
        t EDIT_SELECTED
        t EDIT_NUMBER
        t DELETE_NUMBER
        say "[0] $(t EXIT)"
        t SELECT; read action || return 0
        case "$action" in
            [0-9]*)
                svc=$(awk -F'|' -v n="$action" '$1==n{print $2; exit}' "$RUN/custom-menu")
                [ -n "$svc" ] || { say "$(t INVALID)"; ui_pause; continue; }
                edit_custom_service "$svc"; ui_pause;;
            e|E)
                t SELECT; read n || n=''
                svc=$(awk -F'|' -v n="$n" '$1==n{print $2; exit}' "$RUN/custom-menu")
                [ -n "$svc" ] || { say "$(t INVALID)"; ui_pause; continue; }
                edit_custom_service "$svc"; ui_pause;;
            d|D)
                t SELECT; read n || n=''
                svc=$(awk -F'|' -v n="$n" '$1==n{print $2; exit}' "$RUN/custom-menu")
                [ -n "$svc" ] || { say "$(t INVALID)"; ui_pause; continue; }
                delete_custom_service "$svc"; ui_pause;;
            0|q|Q) return 0;;
            *) say "$(t INVALID)"; ui_pause;;
        esac
    done
}

add_custom() {
    t ADD_NAME; read s || s=''
    [ -n "$s" ] || { say "$(t INVALID)"; return 1; }
    custom_service_exists "$s" && { t DUP_CUSTOM; return 1; }
    while :; do
        t ADD_DOMAINS; read d || d=''
        validate_domains "$d" && break
        t DOMAIN_RETRY
        case "$d" in 0) return 1;; esac
    done
    norm="$(normalize_domains "$d")"
    [ -n "$norm" ] || { t DOMAIN_INVALID; return 1; }
    t ADD_TCP; read tcp || tcp=''; [ -n "$tcp" ] || tcp=443
    t ADD_UDP; read udp || udp=''; [ -n "$udp" ] || udp=443
    cat >> "$CUSTOM_SERVICES" <<EOF2

SERVICE=$s
DESCRIPTION=Custom service
DOMAINS="$norm"
TCP_PORTS="$tcp"
UDP_PORTS="$udp"
HTTP_TEST=1
HTTPS_TEST=1
QUIC_TEST=1
EOF2
    printf "%s%s\n" "$(t ADDED)" "$s"
}

set_first_blockcheck_target() {
    ensure_default_files
    rm -f "$STATE/blockcheck.domain" "$STATE/blockcheck.service"
    while IFS= read -r svc; do
        [ -n "$svc" ] || continue
        dom="$(service_primary_domain "$svc" | head -n1)"
        if [ -n "$dom" ] && valid_domain "$dom"; then
            printf '%s\n' "$svc" > "$STATE/blockcheck.service"
            printf '%s\n' "$dom" > "$STATE/blockcheck.domain"
            return 0
        fi
        rec="$(service_record "$svc")"
        IFS='|' read -r _ _ doms _ _ _ _ _ groups <<EOF2
$rec
EOF2
        for d in $doms; do
            if valid_domain "$d"; then
                printf '%s\n' "$svc" > "$STATE/blockcheck.service"
                printf '%s\n' "$d" > "$STATE/blockcheck.domain"
                return 0
            fi
        done
        if [ -n "${groups:-}" ]; then
            oldifs="$IFS"; IFS=';'
            for grp in $groups; do
                gdoms="${grp#*::}"
                for d in $gdoms; do
                    if valid_domain "$d"; then
                        printf '%s\n' "$svc" > "$STATE/blockcheck.service"
                        printf '%s\n' "$d" > "$STATE/blockcheck.domain"
                        IFS="$oldifs"
                        return 0
                    fi
                done
            done
            IFS="$oldifs"
        fi
    done < "$STATE/services.list"
    return 1
}

select_blockcheck_target() {
    ensure_default_files
    if [ ! -s "$STATE/services.list" ]; then
        select_services_interactive || return 1
    fi
    rm -f "$STATE/blockcheck.domain" "$STATE/blockcheck.service"
    clear 2>/dev/null || true
    say '=============================================='
    say " $(t BLOCKCHECK_MENU)"
    say '=============================================='
    t BLOCKCHECK_TARGET_INFO1
    t BLOCKCHECK_TARGET_INFO2
    t BLOCKCHECK_TARGET_INFO3
    say ''
    parse_services > "$RUN/blockcheck-service-source"
    i=1; : > "$RUN/blockcheck-service-menu"
    while IFS='|' read -r svc desc dom tcp udp ht hts q groups; do
        [ -n "$svc" ] || continue
        printf '[%d] %s\n' "$i" "$svc"
        printf '%d|%s\n' "$i" "$svc" >> "$RUN/blockcheck-service-menu"
        i=$((i+1))
    done < "$RUN/blockcheck-service-source"
    say "[0] $(t EXIT)"
    t SELECT_BC_SERVICE; read n || n=''
    case "$n" in 0|q|Q) return 1;; esac
    svc=$(awk -F'|' -v n="$n" '$1==n{print $2; exit}' "$RUN/blockcheck-service-menu")
    [ -n "$svc" ] || { say "$(t INVALID)"; return 1; }
    printf '%s\n' "$svc" > "$STATE/blockcheck.service"
    rec="$(service_record "$svc")"
    IFS='|' read -r _ _ domains _ _ _ _ _ groups <<EOF2
$rec
EOF2
    primary="$(service_primary_domain "$svc" | head -n1)"
    valid_list=''
    [ -n "$primary" ] && valid_domain "$primary" && valid_list="$primary"
    for d in $domains; do
        valid_domain "$d" || continue
        case " $valid_list " in *" $d "*) :;; *) valid_list="$valid_list $d";; esac
    done
    [ -n "$valid_list" ] || { t NO_VALID_BC_DOMAINS; return 1; }
    say ''
    say "TARGETS: $svc"
    idx=0
    for d in $valid_list; do
        idx=$((idx+1))
        if [ "$idx" -eq 1 ]; then printf '  [%02d] → %s\n' "$idx" "$d"; else printf '  [%02d]   %s\n' "$idx" "$d"; fi
    done
    target="$primary"
    [ -n "$target" ] || target="$(printf '%s\n' $valid_list | head -n1)"
    printf '%s\n' "$target" > "$STATE/blockcheck.domain"
    t AUTO_TARGET; printf '%s\n' "$target"
}

