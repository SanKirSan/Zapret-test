# ANSI colors are used only when stdout is a TTY and NO_COLOR is not set.
COLOR_ENABLED=0
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then COLOR_ENABLED=1; fi
C_RESET= C_BOLD= C_DIM= C_CYAN= C_GREEN= C_YELLOW= C_RED= C_BG_GREEN= C_BG_YELLOW= C_BG_RED= C_FG_BLACK= C_FG_WHITE=
if [ "$COLOR_ENABLED" = 1 ]; then
    C_RESET=$(printf '\033[0m')
    C_BOLD=$(printf '\033[1m')
    C_DIM=$(printf '\033[2m')
    C_CYAN=$(printf '\033[36m')
    C_GREEN=$(printf '\033[32m')
    C_YELLOW=$(printf '\033[33m')
    C_RED=$(printf '\033[31m')
    C_BG_GREEN=$(printf '\033[42m')
    C_BG_YELLOW=$(printf '\033[43m')
    C_BG_RED=$(printf '\033[41m')
    C_FG_BLACK=$(printf '\033[30m')
    C_FG_WHITE=$(printf '\033[97m')
fi
colorize() { color="$1"; text="$2"; printf '%s%s%s' "$color" "$text" "$C_RESET"; }
badge() {
    _bg="$1"; _fg="$2"; _text="$3"
    [ "$COLOR_ENABLED" = 1 ] && printf '%s%s%s %s %s%s' "$_bg" "$_fg" "$C_BOLD" "$_text" "$C_RESET" "" || printf '[ %s ]' "$_text"
}

# UI language: Y = Russian, N = English. Technical values/status codes remain unchanged.
choose_language() {
    [ "${ZAPRET_TEST_LANG_PROMPT:-1}" = 0 ] && return 0
    t LANG_PROMPT; printf ' '
    read lang_answer || lang_answer=y
    case "$lang_answer" in
        n|N) LANG_MODE=EN ;;
        *) LANG_MODE=RU ;;
    esac
    export LANG_MODE
}

