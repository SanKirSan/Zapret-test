parse_services() {
    cat "$SERVICE_DB" "$CUSTOM_SERVICES" 2>/dev/null | awk '
    function emit(){ if(s!=""){ print s "|" d "|" dom "|" tcp "|" udp "|" http "|" https "|" quic "|" groups } s=d=dom=tcp=udp=http=https=quic=groups="" }
    /^SERVICE=/{emit(); s=$0; sub(/^SERVICE=/,"",s); gsub(/^"|"$/,"",s); next}
    /^DESCRIPTION=/{d=$0; sub(/^DESCRIPTION=/,"",d); gsub(/^"|"$/,"",d); next}
    /^DOMAINS=/{dom=$0; sub(/^DOMAINS=/,"",dom); gsub(/^"|"$/,"",dom); next}
    /^TCP_PORTS=/{tcp=$0; sub(/^TCP_PORTS=/,"",tcp); gsub(/^"|"$/,"",tcp); next}
    /^UDP_PORTS=/{udp=$0; sub(/^UDP_PORTS=/,"",udp); gsub(/^"|"$/,"",udp); next}
    /^HTTP_TEST=/{http=$0; sub(/^HTTP_TEST=/,"",http); next}
    /^HTTPS_TEST=/{https=$0; sub(/^HTTPS_TEST=/,"",https); next}
    /^QUIC_TEST=/{quic=$0; sub(/^QUIC_TEST=/,"",quic); next}
    /^GROUPS=/{groups=$0; sub(/^GROUPS=/,"",groups); gsub(/^"|"$/,"",groups); next}
    END{emit()}'
}

service_record() { parse_services | grep -F "$1|" | head -n1; }

service_primary_domain() {
