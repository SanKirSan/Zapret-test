# ---------- probes ----------
classify_curl() {
    rc="$1"
    case "$rc" in
      0) echo PASS;;
      6) echo DNS_FAILURE;;
      7) echo TCP_FAILURE;;
      28) echo TIMEOUT;;
      35) echo TLS_FAILURE;;
      47) echo HTTP_FAILURE;;
      1|2|3|4) echo UNSUPPORTED;;
      *) echo UNKNOWN;;
    esac
}

curl_probe() {
    url="$1"; extra="$2"; hdr="$RUN/hdr.$$.txt"
    start=$(now_ms)
    # shellcheck disable=SC2086
    "$CURL" -k -sS -A "$USER_AGENT" -D "$hdr" -o /dev/null --connect-timeout "$TIMEOUT" --max-time "$TIMEOUT" $extra "$url" >/dev/null 2>"$RUN/curl.err"
    rc=$?; end=$(now_ms); ms=$((end-start));
    code="$(sed -n '1s/^HTTP\/[0-9.]* \([0-9][0-9][0-9]\).*/\1/p' "$hdr" 2>/dev/null | head -n1)"
    loc="$(sed -n 's/^[Ll]ocation:[[:space:]]*//p' "$hdr" 2>/dev/null | head -n1 | tr -d '\r')"
    rm -f "$hdr"
    printf '%s|%s|%s|%s\n' "$rc" "$(classify_curl "$rc")" "$ms" "${code:-NA}|${loc:-}"
    return 0
}

dns_probe() {
    host="$1"
    _ip=""
    if has dig; then
        _ip="$(dig +short "$host" A 2>/dev/null | grep -E '^[0-9.]+$' | head -n1 || true)"
    elif has nslookup; then
        _ip="$(nslookup "$host" 2>/dev/null | sed -n 's/.*Address: *\([0-9][0-9.]*\).*/\1/p' | head -n1 || true)"
    elif has host; then
        _ip="$(host "$host" 2>/dev/null | awk '/has address/{print $4; exit}' || true)"
    else
        echo UNAVAILABLE; return 0
    fi
    [ -n "$_ip" ] || { echo DNS_FAILURE; return 0; }
    case "$_ip" in
        127.0.0.42|198.18.*|198.19.*) echo "DNS_SYNTHETIC|$_ip"; return 0;;
    esac
    echo "PASS|$_ip"
}

dns_configured_resolvers() {
    _f="/tmp/resolv.conf.d/resolv.conf.auto"
    [ -s "$_f" ] || _f="/etc/resolv.conf"
    awk '/^nameserver /{print $2}' "$_f" 2>/dev/null | head -n5
}

is_synthetic_ip() {
    case "$1" in 127.0.0.42|198.18.*|198.19.*) return 0;; esac
    return 1
}

dns_integrity_probe() {
    _host="$1"; _local=""; _up=""; _doh=""; _up_server=""
    if has dig; then
        _local="$(dig @127.0.0.1 +time=2 +tries=1 +short "$_host" A 2>/dev/null | grep -E '^[0-9.]+$' | head -n1 || true)"
        while IFS= read -r _r; do
            [ -n "$_r" ] || continue
            case "$_r" in 127.0.0.1|::1) continue;; esac
            _up="$(dig @"$_r" +time=2 +tries=1 +short "$_host" A 2>/dev/null | grep -E '^[0-9.]+$' | head -n1 || true)"
            [ -n "$_up" ] && { _up_server="$_r"; break; }
        done <<EOF2
$(dns_configured_resolvers)
EOF2
    fi
    _kind=DNS_FAILURE
    if [ -n "$_local" ]; then
        if is_synthetic_ip "$_local"; then _kind=DNS_SYNTHETIC; else _kind=PASS; fi
    fi
    if [ "$_kind" = DNS_SYNTHETIC ] || [ -z "$_up" ]; then
        if has curl && has jq; then
            # Try configured DoH first, then independent public resolvers.
            doh_urls="${DOH_URL:-https://cloudflare-dns.com/dns-query}|https://dns.google/resolve?name=$_host&type=A|https://dns.quad9.net/dns-query?name=$_host&type=A"
            oldifs="$IFS"; IFS='|'
            for _du in $doh_urls; do
                case "$_du" in *dns.google*)
                    _doh="$(curl -4 -fsS --connect-timeout 3 --max-time 6 -H 'accept: application/dns-json' "$_du" 2>/dev/null | jq -r '.Answer[]?.data' 2>/dev/null | grep -E '^[0-9.]+$' | head -n1 || true)";;
                *)
                    _doh="$(curl -4 -fsS --connect-timeout 3 --max-time 6 -H 'accept: application/dns-json' "$_du" 2>/dev/null | jq -r '.Answer[]?.data' 2>/dev/null | grep -E '^[0-9.]+$' | head -n1 || true)";;
                esac
                [ -n "$_doh" ] && break
            done
            IFS="$oldifs"
        fi
    fi
    printf '%s|%s|%s|%s|%s\n' "$_kind" "$_local" "$_up" "$_doh" "$_up_server"
}

tcp_probe() {
    host="$1"; port="$2"
    # zapret2 upstream explicitly prefers ncat; BusyBox nc is unsupported.
    if has ncat; then
        ncat -z -w "$TIMEOUT" "$host" "$port" >/dev/null 2>&1 && echo PASS || echo TCP_FAILURE
    elif has nc && ! nc 2>&1 | grep -qi busybox; then
        nc -z -w "$TIMEOUT" "$host" "$port" >/dev/null 2>&1 && echo PASS || echo TCP_FAILURE
    else
        echo UNAVAILABLE
    fi
}

tls_probe() {
    host="$1"; ver="$2"
    [ -x "$OPENSSL" ] || { echo UNAVAILABLE; return; }
    start=$(now_ms)
    case "$ver" in
      1.2) "$OPENSSL" s_client -connect "$host:443" -servername "$host" -tls1_2 -brief </dev/null >/dev/null 2>"$RUN/openssl.err";;
      1.3) "$OPENSSL" s_client -connect "$host:443" -servername "$host" -tls1_3 -brief </dev/null >/dev/null 2>"$RUN/openssl.err";;
      *) echo UNAVAILABLE; return;;
    esac
    rc=$?; end=$(now_ms); ms=$((end-start));
    [ "$rc" = 0 ] && echo "PASS|$ms" || echo "TLS${ver}_FAILURE|$ms"
}

http3_capable() {
    "$CURL" --help 2>&1 | grep -q -- '--http3' && return 0
    "$CURL" --version 2>&1 | grep -qi 'HTTP3' && return 0
    return 1
}

host_is_ipv6() { echo "$1" | grep -q ':'; }
resolve_ips() {
    host="$1"
    if has nslookup; then nslookup "$host" 2>/dev/null | awk '/^Address: /{print $2}' | tr '\n' ' '
    elif has host; then host "$host" 2>/dev/null | awk '/has address|has IPv6 address/{print $NF}' | tr '\n' ' '
    fi
}

resolve_ips_for_strategy() {
    host="$1"
    local_result="$(dns_probe "$host" 2>/dev/null || true)"
    case "$local_result" in
        PASS\|*) resolve_ips "$host" ;;
        DNS_SYNTHETIC*|DNS_FAILURE*)
            doh_result="$(dns_integrity_probe "$host" 2>/dev/null || true)"
            doh_ip="$(printf '%s' "$doh_result" | cut -d'|' -f4)"
            if [ -n "$doh_ip" ] && ! is_synthetic_ip "$doh_ip"; then
                printf '%s ' "$doh_ip"
            else
                resolve_ips "$host"
            fi
            ;;
        *) resolve_ips "$host" ;;
    esac
}

