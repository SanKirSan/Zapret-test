baseline() {
    say ''
    say '============================================================'
    say " $(t PREPARE_BASELINE)"
    say '============================================================'
    say "$(t SERVICES):"
    while IFS= read -r s; do
        [ -n "$s" ] || continue
        say "  - $s"
        print_service_groups "$s"
    done < "$STATE/services.list"
    say '------------------------------------------------------------'
    t DNS_TRANSPORT
    say "$(t RUNNING)"
    say ''
    baseline_worker > "$RUN/baseline-worker.out" 2> "$RUN/baseline-worker.err" &
    bp=$!
    frames='|/-\\'
    i=0
    start_epoch="$(date +%s)"
    while kill -0 "$bp" 2>/dev/null; do
        now_epoch="$(date +%s)"
        elapsed=$((now_epoch-start_epoch))
        idx=$((i % 4 + 1))
        frame="$(printf '%s' "$frames" | cut -c "$idx")"
        progress="$(cat "$RUN/baseline-progress" 2>/dev/null || true)"
        if [ -n "$progress" ]; then
            pn="$(printf '%s' "$progress" | cut -d'|' -f1)"
            pt="$(printf '%s' "$progress" | cut -d'|' -f2)"
            pd="$(printf '%s' "$progress" | cut -d'|' -f3)"
            ps="$(printf '%s' "$progress" | cut -d'|' -f4)"
            [ -n "$ps" ] || ps="CHECK"
            printf '\r  [%s] %s... %s/%s %-28s [%s] %02d:%02d' "$frame" "$(t RUNNING)" "$pn" "$pt" "$pd" "$ps" $((elapsed/60)) $((elapsed%60))
        else
            printf '\r  [%s] %s... %02d:%02d' "$frame" "$(t PREPARE_BASELINE)" $((elapsed/60)) $((elapsed%60))
        fi
        sleep 1
        i=$((i+1))
    done
    wait "$bp" 2>/dev/null || true
    printf '\r%s\r' '                                                                                '
    err_file="$RUN/baseline-worker.err"
    if [ -s "$err_file" ]; then
        say "$(t RUNNING): warning"
        sed 's/^/  /' "$err_file"
    fi
    print_baseline_results
    say "$(t BASELINE_DONE)"
    say '============================================================'
    rm -f "$RUN/baseline-progress" "$RUN/baseline-worker.out" "$RUN/baseline-worker.err"
}

