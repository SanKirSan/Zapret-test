cmd_debug() {
    ensure_default_files; load_config; ATTEMPTS=3; FULL_MAX_CANDIDATES=0; BLOCKCHECK_SCANLEVEL=force; detect_system; detect_zapret; detect_zapret2; report_init
    [ -s "$STATE/services.list" ] || select_services_interactive || return 1
    DEEP_DIAGNOSTICS=1
    rm -f "$STATE/blockcheck.domain" "$STATE/blockcheck.service"
    backup_create; stop_engine_services || die 'failed to stop installed services'
    : > "$RUN/strategy-results"
    if [ -z "$(cat "$STATE/blockcheck.domain" 2>/dev/null || true)" ]; then set_first_blockcheck_target || return 1; fi
    ENABLE_TCPDUMP=1
    # Extended diagnostics are the only mode allowed to create Cxxxx evidence IDs.
    # Normal modes always use Sxxxx IDs.
    for e in $(engines_to_test); do
        db="$BLOCKDIR/${e}.db"
        rm -f "$db" "$BLOCKDIR/${e}.candidates"
        run_engine_blockcheck "$e" C
        run_rc=$?
        if [ "$run_rc" -eq 130 ] || [ "$run_rc" -eq 143 ]; then
            interrupted=1
            break
        fi
        [ "$run_rc" -eq 0 ] || continue
        [ -s "$db" ] && run_strategy_tests "$e" "$db" "${ATTEMPTS:-3}" || true
    done
    restore_all || { ROLLBACK_OK=0; }
    finalize_report
    DEEP_DIAGNOSTICS=0
    [ "${interrupted:-0}" = 1 ] && return 130
    t DEBUG_ONLY
    say "Report: $REPORT_TXT"
}

cmd_restore() {
    need_root; ensure_default_files; load_config; detect_system; detect_zapret; detect_zapret2
    cleanup_ours
    restart_engine_services || { say 'CRITICAL: could not restart services'; exit 2; }
    t RESTORED
}

cmd_report() {
    [ -f "$REPORT_TXT" ] && cat "$REPORT_TXT" || say "No report: $REPORT_TXT"
}

cmd_apply() {
    ensure_default_files; need_root
    file="$1"
    [ -f "$file" ] || die "config file not found: $file"
    detect_system; detect_zapret; detect_zapret2; backup_create
    echo "ENGINE/strategy config:"; cat "$file"; echo
    printf 'Apply this configuration? [y/N] '; read ans
    case "$ans" in y|Y)
      # Intentional: application is only supported for explicit raw command configs.
      # This v1 writes the selected config to a clearly named staging file and does not rewrite vendor UCI automatically.
      cp "$file" "$RUN/apply.conf"
      say "Staged at $RUN/apply.conf. No vendor config was rewritten automatically."
      ;; *) say 'Not applied.';; esac
}

cmd_custom() { ensure_default_files; add_custom; }


package_manager_detect() {
    if has apk; then
        if [ -r /etc/openwrt_release ]; then PKG_MANAGER=apk-openwrt; else PKG_MANAGER=apk; fi
    elif has opkg; then PKG_MANAGER=opkg
    elif has apt-get; then PKG_MANAGER=apt
    elif has dnf; then PKG_MANAGER=dnf
    elif has yum; then PKG_MANAGER=yum
    elif has pacman; then PKG_MANAGER=pacman
    elif has zypper; then PKG_MANAGER=zypper
    else PKG_MANAGER=none; PKG_MANAGER_VERSION=unavailable; return 0
    fi
    case "$PKG_MANAGER" in
        apk-openwrt|apk) PKG_MANAGER_VERSION="$(apk --version 2>/dev/null | head -n1 || echo unavailable)";;
        opkg) PKG_MANAGER_VERSION="$(opkg --version 2>/dev/null | head -n1 || echo unavailable)";;
        apt) PKG_MANAGER_VERSION="$(apt-get --version 2>/dev/null | head -n1 || echo unavailable)";;
        dnf) PKG_MANAGER_VERSION="$(dnf --version 2>/dev/null | head -n1 || echo unavailable)";;
        yum) PKG_MANAGER_VERSION="$(yum --version 2>/dev/null | head -n1 || echo unavailable)";;
        pacman) PKG_MANAGER_VERSION="$(pacman --version 2>/dev/null | head -n1 || echo unavailable)";;
        zypper) PKG_MANAGER_VERSION="$(zypper --version 2>/dev/null | head -n1 || echo unavailable)";;
    esac
}

package_name_for_manager() {
    case "$1" in
        apk-openwrt) awk -F'|' -v c="$2" '$1==c{print $2; exit}' "$REQ_FILE";;
        opkg) awk -F'|' -v c="$2" '$1==c{print $3; exit}' "$REQ_FILE";;
        apt) awk -F'|' -v c="$2" '$1==c{print $4; exit}' "$REQ_FILE";;
        dnf|yum) awk -F'|' -v c="$2" '$1==c{print $5; exit}' "$REQ_FILE";;
        pacman) awk -F'|' -v c="$2" '$1==c{print $6; exit}' "$REQ_FILE";;
        zypper) awk -F'|' -v c="$2" '$1==c{print $7; exit}' "$REQ_FILE";;
        apk) awk -F'|' -v c="$2" '$1==c{print $8; exit}' "$REQ_FILE";;
    esac
}

package_installed() {
    pkg="$1"
    case "$PKG_MANAGER" in
        apk-openwrt|apk) apk info -e "$pkg" >/dev/null 2>&1;;
        opkg) opkg status "$pkg" 2>/dev/null | grep -q '^Status: install ok installed';;
        apt) dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed';;
        dnf|yum|zypper) rpm -q "$pkg" >/dev/null 2>&1;;
        pacman) pacman -Q "$pkg" >/dev/null 2>&1;;
        *) return 1;;
    esac
}

requirements_status() {
    say '============================================================'
    say ' PACKAGE REQUIREMENTS'
    say '============================================================'
    package_manager_detect
    say "Package manager : $PKG_MANAGER"
    say "Manager version : $PKG_MANAGER_VERSION"
    say "Requirements    : $REQ_FILE"
    say '------------------------------------------------------------'
    [ -f "$REQ_FILE" ] || { say '[ERROR] requirements.conf not installed'; return 1; }
    printf '%-14s %-10s %-10s %-24s %s\n' 'COMMAND' 'MODE' 'STATUS' 'PACKAGE' 'PURPOSE'
    while IFS='|' read -r cmd apk_pkg opkg_pkg apt_pkg dnf_pkg pacman_pkg zypper_pkg alpine_pkg mode purpose; do
        case "$cmd" in ''|\#*) continue;; esac
        pkg="$(package_name_for_manager "$PKG_MANAGER" "$cmd")"
        [ -n "$pkg" ] || pkg='N/A'
        if has "$cmd"; then cmd_status=OK; else cmd_status=MISSING; fi
        if [ "$PKG_MANAGER" != none ] && [ "$pkg" != N/A ] && package_installed "$pkg"; then pkg_status=INSTALLED; else pkg_status=NOT_INSTALLED; fi
        printf '%-14s %-10s %-10s %-24s %s\n' "$cmd" "$mode" "$cmd_status/$pkg_status" "$pkg" "$purpose"
    done < "$REQ_FILE"
    say '------------------------------------------------------------'
    case "$PKG_MANAGER" in
        apk-openwrt|apk) say "$(t INSTALLED_LIST)apk info -vv";;
        opkg) say "$(t INSTALLED_LIST)opkg list-installed";;
        apt) say "$(t INSTALLED_LIST)dpkg-query";;
        dnf|yum|zypper) say "$(t INSTALLED_LIST)rpm -qa";;
        pacman) say "$(t INSTALLED_LIST)pacman -Q";;
        *) say "$(t PKG_MANAGER_NONE)";;
    esac
}


