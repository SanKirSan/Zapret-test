# ---------- candidate handling ----------
extract_candidates() {
    src="$1"; engine="$2"; out="$BLOCKDIR/${engine}.candidates"
    : > "$out"
    # Preserve all command-like strategy lines. The parser deliberately refuses to invent options.
    # Known zapret/zapret2 option prefixes are extracted only from upstream raw output.
    grep -E -- '(^|[[:space:]])(--(filter-|payload=|lua-desync=|dpi-desync-|hostlist=|ipset=|fwmark=|qnum=|user=)|--lua-init=)' "$src" 2>/dev/null \
      | sed 's/^.*\(nfqws[^ ]*\|nfqws2[^ ]*\|--filter-.*\|--payload=.*\|--lua-desync=.*\|--dpi-desync-.*\)/\1/' \
      | sed 's/[" ]*$//' \
      | awk '!seen[$0]++' | head -n "${FULL_MAX_CANDIDATES:-0}" > "$out" 2>/dev/null || true
    # If no head limit is desired, recover full de-duplicated set.
    if [ "${FULL_MAX_CANDIDATES:-0}" = 0 ]; then
      grep -E -- '(^|[[:space:]])(--(filter-|payload=|lua-desync=|dpi-desync-|hostlist=|ipset=))' "$src" 2>/dev/null | sed 's/^[[:space:]]*//' | awk '!seen[$0]++' > "$out" || true
    fi
    echo "$out"
}

stop_manual_dpi_bypass_processes() {
    stopped=0
    self="$$"
    for pid in $(ps 2>/dev/null | awk 'NR>1 && $1 ~ /^[0-9]+$/ {print $1}' | sort -u); do
        [ "$pid" = "$self" ] && continue
        [ -r "/proc/$pid/cmdline" ] || continue
        cmd="$(tr '\000' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
        case "$cmd" in
            *nfqws2*|*"/nfqws "*|*" nfqws "*)
                case "$cmd" in *zapret-test*) continue;; esac
                kill -TERM "$pid" 2>/dev/null || true
                stopped=$((stopped+1))
                ;;
        esac
    done
    if [ "$stopped" -gt 0 ]; then
        sleep 1
        for pid in $(ps 2>/dev/null | awk 'NR>1 && $1 ~ /^[0-9]+$/ {print $1}' | sort -u); do
            [ "$pid" = "$self" ] && continue
            [ -r "/proc/$pid/cmdline" ] || continue
            cmd="$(tr '\000' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
            case "$cmd" in
                *nfqws2*|*"/nfqws "*|*" nfqws "*)
                    case "$cmd" in *zapret-test*) continue;; esac
                    kill -KILL "$pid" 2>/dev/null || true
                    ;;
            esac
        done
    fi
    DPI_STOPPED_COUNT="$stopped"
    return 0
}


run_blockcheck() {
    engine="$1"; domains="$2"; mode="$3"
    [ -n "$domains" ] || return 1
    ts="$(date '+%Y%m%d-%H%M%S')"
    case "$engine" in
      ZAPRET) out="$BLOCKDIR/blockcheck-${ts}.txt"; latest="$BLOCKDIR/blockcheck-latest.txt"; script="$BLOCKCHECK"; base="$ZAPRET_BASE"; name="blockcheck.sh"; label="zapret";;
      ZAPRET2) out="$BLOCKDIR/blockcheck2-${ts}.txt"; latest="$BLOCKDIR/blockcheck2-latest.txt"; script="$BLOCKCHECK2"; base="$ZAPRET2_BASE"; name="blockcheck2.sh"; label="zapret2";;
      *) return 1;;
    esac
    : > "$out"
    # Upstream blockcheck2 requires all existing DPI-bypass processes to be stopped.
    # Stop both init-managed and manually started nfqws/nfqws2 instances here.
    stop_manual_dpi_bypass_processes
    fifo="$RUN/blockcheck-$$.fifo"
    sum_fifo="$RUN/blockcheck-summary-$$.fifo"
    status_file="$RUN/blockcheck-$$.status"
    rm -f "$fifo" "$sum_fifo" "$status_file"
    mkfifo "$fifo" 2>/dev/null || return 1
    if [ "$BLOCKCHECK_OUTPUT_MODE" != raw ]; then
        mkfifo "$sum_fifo" 2>/dev/null || { rm -f "$fifo"; return 1; }
    fi

    BLOCKCHECK_RUNNING_ENGINE="$engine"
    BLOCKCHECK_RUNNING_LOG="$out"
    SIGNAL_STAGE=blockcheck
    BLOCKCHECK_READER_PID=""
    BLOCKCHECK_SUMMARY_PID=""
    BLOCKCHECK_UPSTREAM_PID=""
    : > "$RUN/active.blockcheck.pid"

    blockcheck_signal_handler() {
        interrupted=1
        # Stop both output-reader processes. The old implementation tracked only
        # the last process in a background pipeline, leaving tee orphaned.
        if [ -n "${BLOCKCHECK_SUMMARY_PID:-}" ]; then
            kill_tree "$BLOCKCHECK_SUMMARY_PID" >/dev/null 2>&1 || true
            kill -KILL "$BLOCKCHECK_SUMMARY_PID" 2>/dev/null || true
        fi
        if [ -n "${BLOCKCHECK_READER_PID:-}" ]; then
            kill_tree "$BLOCKCHECK_READER_PID" >/dev/null 2>&1 || true
            kill -KILL "$BLOCKCHECK_READER_PID" 2>/dev/null || true
        fi
        # The upstream wrapper runs in its own process group. Send TERM to the
        # whole group so blockcheck2 can execute its own cleanup handler.
        kill_active_record "$RUN/active.blockcheck.pid" >/dev/null 2>&1 || true
        printf '%s\n' 130 > "$status_file"
    }

    say ''
    say '============================================================'
    say " $name — LIVE TEST"
    say '============================================================'
    say "zapret-test   : $VERSION"
    if [ "${LANG_MODE:-RU}" = RU ]; then say "Движок        : $label"; else say "Engine        : $label"; fi
    if [ "${LANG_MODE:-RU}" = RU ]; then say "Скрипт        : $script"; else say "Script        : $script"; fi
    display_mode="$mode"
    [ "$mode" = force ] && display_mode=full
    if [ "${LANG_MODE:-RU}" = RU ]; then say "Уровень сканирования : $display_mode"; else say "Scan level    : $display_mode"; fi
    if [ "${BLOCKCHECK_TIMEOUT:-0}" -gt 0 ] 2>/dev/null; then
        if [ "${LANG_MODE:-RU}" = RU ]; then say "Ограничение   : ${BLOCKCHECK_TIMEOUT}s"; else say "Time limit    : ${BLOCKCHECK_TIMEOUT}s"; fi
    else
        if [ "${LANG_MODE:-RU}" = RU ]; then say "Ограничение   : без ограничения"; else say "Time limit    : unlimited"; fi
    fi
    if [ "${LANG_MODE:-RU}" = RU ]; then say "Домен         : $domains"; else say "Domain        : $domains"; fi
    if [ "${LANG_MODE:-RU}" = RU ]; then say "Режим вывода   : $BLOCKCHECK_OUTPUT_MODE"; else say "Output mode   : $BLOCKCHECK_OUTPUT_MODE"; fi
    if [ "${LANG_MODE:-RU}" = RU ]; then say "Raw-отчёт     : $out"; else say "Raw capture   : $out"; fi
    say '------------------------------------------------------------'
    say "[$(t TAG_PROCESS)] $(t PROCESS_HINT1)"
    say "[$(t TAG_PROCESS)] $(t PROCESS_HINT2)"
    say '------------------------------------------------------------'

    # Keep tee and summary as independent children, not one anonymous pipeline.
    if [ "$BLOCKCHECK_OUTPUT_MODE" = raw ]; then
        tee "$out" < "$fifo" &
        BLOCKCHECK_READER_PID=$!
    else
        blockcheck_summary "$label" < "$sum_fifo" &
        BLOCKCHECK_SUMMARY_PID=$!
        tee "$out" < "$fifo" > "$sum_fifo" &
        BLOCKCHECK_READER_PID=$!
    fi

    start_epoch="$(date +%s)"
    if has setsid; then
        setsid sh -c '
            rc=1
            if [ -x "$1" ]; then
                cd "$2" 2>/dev/null || exit 125
                if [ "${BLOCKCHECK_TIMEOUT:-0}" -gt 0 ] 2>/dev/null; then
                    timeout "$BLOCKCHECK_TIMEOUT" env BATCH=1 DOMAINS="$3" DOMAINS_DEFAULT="$3" TEST=standard SCANLEVEL="$4" CURL_MAX_TIME="$BLOCKCHECK_CURL_MAX_TIME" CURL_MAX_TIME_QUIC="$BLOCKCHECK_CURL_MAX_TIME_QUIC" "$1"
                    rc=$?
                else
                    BATCH=1 DOMAINS="$3" DOMAINS_DEFAULT="$3" TEST=standard SCANLEVEL="$4" CURL_MAX_TIME="$BLOCKCHECK_CURL_MAX_TIME" CURL_MAX_TIME_QUIC="$BLOCKCHECK_CURL_MAX_TIME_QUIC" "$1"
                    rc=$?
                fi
            else
                printf "[ERROR] %s is not executable: %s\n" "$5" "${1:-NOT FOUND}"
                rc=127
            fi
            printf "%s\n" "$rc" > "$6"
            exit "$rc"
        ' sh "$script" "$base" "$domains" "$mode" "$name" "$status_file" > "$fifo" 2>&1 &
        isolated=1
    else
        (
            rc=1
            if [ -x "$script" ]; then
                cd "$base" 2>/dev/null || exit 125
                if [ "${BLOCKCHECK_TIMEOUT:-0}" -gt 0 ] 2>/dev/null; then
                    timeout "$BLOCKCHECK_TIMEOUT" env BATCH=1 DOMAINS="$domains" DOMAINS_DEFAULT="$domains" TEST=standard SCANLEVEL="$mode" CURL_MAX_TIME="$BLOCKCHECK_CURL_MAX_TIME" CURL_MAX_TIME_QUIC="$BLOCKCHECK_CURL_MAX_TIME_QUIC" "$script"
                    rc=$?
                else
                    BATCH=1 DOMAINS="$domains" DOMAINS_DEFAULT="$domains" TEST=standard SCANLEVEL="$mode" CURL_MAX_TIME="$BLOCKCHECK_CURL_MAX_TIME" CURL_MAX_TIME_QUIC="$BLOCKCHECK_CURL_MAX_TIME_QUIC" "$script"
                    rc=$?
                fi
            else
                printf '[ERROR] %s is not executable: %s\n' "$name" "${script:-NOT FOUND}"
                rc=127
            fi
            printf '%s\n' "$rc" > "$status_file"
            exit "$rc"
        ) > "$fifo" 2>&1 &
        isolated=0
    fi
    cmd_pid=$!
    BLOCKCHECK_UPSTREAM_PID="$cmd_pid"
    pgid="$(ps -o pgid= -p "$cmd_pid" 2>/dev/null | tr -d ' ' || true)"
    printf '%s|%s|%s\n' "$cmd_pid" "$pgid" "$isolated" > "$RUN/active.blockcheck.pid"
    BLOCKCHECK_RUNNING_PID="$cmd_pid"
    interrupted=0

    heartbeat=0
    while [ ! -f "$status_file" ]; do
        if [ "$interrupted" -eq 1 ]; then
            break
        fi
        if ! kill -0 "$cmd_pid" 2>/dev/null; then
            printf '125\n' > "$status_file"
            break
        fi
        sleep 1
        [ -f "$status_file" ] && continue
        heartbeat=$((heartbeat+1))
        if [ $((heartbeat % 5)) -eq 0 ] && [ "$interrupted" -eq 0 ]; then
            now_epoch="$(date +%s)"
            elapsed=$((now_epoch-start_epoch))
            printf '[%s] %s | domain=%s | elapsed=%02d:%02d:%02d | pid=%s | strategy scan in progress\n' "$(t TAG_RUNNING)" "$label" "$domains" $((elapsed/3600)) $(((elapsed%3600)/60)) $((elapsed%60)) "$cmd_pid"
        fi
    done

    wait "$cmd_pid" 2>/dev/null || true
    if [ -n "${BLOCKCHECK_READER_PID:-}" ]; then
        wait "$BLOCKCHECK_READER_PID" 2>/dev/null || true
    fi
    if [ -n "${BLOCKCHECK_SUMMARY_PID:-}" ]; then
        wait "$BLOCKCHECK_SUMMARY_PID" 2>/dev/null || true
    fi
    if [ "$interrupted" -eq 0 ] && [ -p "$fifo" ]; then
        sleep 1
    fi
    rc="$(cat "$status_file" 2>/dev/null || echo 125)"
    case "$rc" in ''|*[!0-9]*) rc=125;; esac
    end_epoch="$(date +%s)"
    elapsed=$((end_epoch-start_epoch))
    hours=$((elapsed/3600)); mins=$(((elapsed%3600)/60)); secs=$((elapsed%60))
    status=COMPLETED
    [ "$rc" -eq 130 ] && status=INTERRUPTED
    [ "$interrupted" -eq 1 ] && status=INTERRUPTED && rc=130
    [ "$rc" -ne 0 ] && [ "$status" = COMPLETED ] && status=EXITED_WITH_ERROR
    cp -f "$out" "$latest"

    # Restore the permanent signal dispatcher after this stage and clear markers.
    SIGNAL_STAGE=""
    rm -f "$fifo" "$sum_fifo" "$status_file" "$RUN/active.blockcheck.pid"
    BLOCKCHECK_RUNNING_PID=""
    BLOCKCHECK_RUNNING_ENGINE=""
    BLOCKCHECK_RUNNING_LOG=""
    BLOCKCHECK_READER_PID=""
    BLOCKCHECK_SUMMARY_PID=""
    BLOCKCHECK_UPSTREAM_PID=""

    say '------------------------------------------------------------'
    if [ "${LANG_MODE:-RU}" = RU ]; then
        say "[ГОТОВО] Код выхода  : $rc"
        say "[ГОТОВО] Статус      : $status"
        say "[ГОТОВО] Длительность: $(printf '%02d:%02d:%02d' "$hours" "$mins" "$secs")"
        say "[ГОТОВО] Raw-вывод   : $out"
    else
        say "[$(t TAG_DONE)] Upstream exit : $rc"
        display_status="$status"
        case "$status" in
            INTERRUPTED) [ "${LANG_MODE:-RU}" = RU ] && display_status="$(t STATUS_INTERRUPTED)";;
            COMPLETED) [ "${LANG_MODE:-RU}" = RU ] && display_status="$(t STATUS_COMPLETED)";;
            EXITED_WITH_ERROR) [ "${LANG_MODE:-RU}" = RU ] && display_status="$(t STATUS_ERROR)";;
        esac
        say "[$(t TAG_DONE)] Status        : $display_status"
        say "[$(t TAG_DONE)] Duration      : $(printf '%02d:%02d:%02d' "$hours" "$mins" "$secs")"
        say "[$(t TAG_DONE)] Raw output    : $out"
    fi
    say '============================================================'
    [ "$status" = INTERRUPTED ] && return 130
    [ "$status" = EXITED_WITH_ERROR ] && return "$rc"
    return 0
}

flush_pending_port() {
    [ -n "${pending_port:-}" ] || return 0
    case "${pending_port_state:-0}" in
        1)
            if [ "$COLOR_ENABLED" = 1 ]; then printf "[%s] %s — %s\n" "$(t PORT)" "$pending_port" "$(colorize "$C_GREEN" "$(t ACCESS).")"; else say "[$(t PORT)] $pending_port — $(t ACCESS)."; fi
            ;;
        -1)
            if [ "$COLOR_ENABLED" = 1 ]; then printf "[%s] %s — %s\n" "$(t PORT)" "$pending_port" "$(colorize "$C_RED" "$(t NOACCESS).")"; else say "[$(t PORT)] $pending_port — $(t NOACCESS)."; fi
            ;;
        *)
            if [ "$COLOR_ENABLED" = 1 ]; then printf "[%s] %s — %s\n" "$(t PORT)" "$pending_port" "$(colorize "$C_YELLOW" "$(t PORT_UNKNOWN).")"; else say "[$(t PORT)] $pending_port — $(t PORT_UNKNOWN)."; fi
            ;;
    esac
    pending_port=""
    pending_port_state=0
}
translate_blockcheck_info() {
    line="$1"
    case "$line" in
        *'checking prerequisites'*) say "[$(t TAG_INFO)] $(t INFO_PREREQ)" ;;
        *'checking DNS'*) say "[$(t TAG_INFO)] $(t INFO_DNS)" ;;
        *'searching working DoH server'*) say "[$(t TAG_INFO)] $(t INFO_DOH)" ;;
        *'preparing nfqws2 redirection'*) say "[$(t TAG_INFO)] $(t INFO_NFQ_REDIRECT)" ;;
        *'installed curl version does not support http3'*) say "[$(t TAG_INFO)] $(t INFO_HTTP3_DISABLED)" ;;
        *'!!! WARNING. some dpi bypass processes already running !!!'*) say "[$(t TAG_WARNING)] $(t INFO_DPI_ALREADY_RUNNING)" ;;
        *'!!! WARNING. blockcheck requires all DPI bypass methods disabled !!!'*) say "[$(t TAG_WARNING)] $(t INFO_DPI_REQUIRED_STOP)" ;;
        *'!!! WARNING. pls stop all dpi bypass instances that may interfere with blockcheck !!!'*) say "[$(t TAG_WARNING)] $(t INFO_DPI_STOP_HINT)" ;;
        *) say "[$(t TAG_INFO)] $line" ;;
    esac
}

blockcheck_summary() {
    label="$1"
    idx=0
    current=""
    current_idx=0
    pending_port=""
    pending_port_state=0 # 0=unknown/not tested, 1=connects, -1=does not connect
    available=0
    unavailable=0
    while IFS= read -r line; do
        case "$line" in
            \*\ script\ :*)
                if [ -n "$current" ]; then
                    if [ "$COLOR_ENABLED" = 1 ]; then printf "[%s %03d] %s — %s\n" "$(t STRATEGY)" "$current_idx" "$current" "$(colorize "$C_YELLOW" "$(t RESULT): $(t STRATEGY_UNAVAILABLE)")"; else say "[$(t STRATEGY) $(printf '%03d' "$current_idx")] $current — $(t STRATEGY_UNAVAILABLE)"; fi
                    unavailable=$((unavailable+1)); current=""; current_idx=0
                fi
                flush_pending_port
                stage="${line#*: }"
                if [ "$COLOR_ENABLED" = 1 ]; then printf "%s[%s]%s %s\n" "$C_BOLD" "$(t STAGE)" "$C_RESET" "$stage"; else say "[$(t STAGE)] $stage"; fi
                ;;
            -\ curl_test_*:\ *)
                idx=$((idx+1))
                flush_pending_port
                current="${line#*: }"
                current_idx=$idx
                ;;
            *'port block tests '*)
                flush_pending_port
                pending_port="${line#*\* }"
                pending_port_state=0
                ;;
            *' connects')
                [ -n "$pending_port" ] && pending_port_state=1
                ;;
            *' does not connect.'*)
                [ -n "$pending_port" ] && pending_port_state=-1
                ;;
            *'suitable netcat not found'*)
                if [ -n "$pending_port" ]; then
                    if [ "${LANG_MODE:-RU}" = RU ]; then say "[$(t PORT)] $pending_port — $(t PORT_UNKNOWN). suitable netcat not found."; else say "[$(t PORT)] $pending_port — $(t PORT_UNKNOWN). suitable netcat not found."; fi
                    pending_port=""
                    pending_port_state=0
                fi
                ;;
            *'!!!!! AVAILABLE !!!!!'*)
                if [ -n "$current" ]; then
                    available=$((available+1))
                    if [ "$COLOR_ENABLED" = 1 ]; then printf "[%s %03d] %s — %s\n" "$(t STRATEGY)" "$(printf '%03d' "$current_idx")" "$current" "$(colorize "$C_GREEN" "$(t ACCESS).")"; else say "[$(t STRATEGY) $(printf '%03d' "$current_idx")] $current — $(t ACCESS)."; fi
                    current=""; current_idx=0
                fi
                flush_pending_port
                ;;
            *'UNAVAILABLE code='*)
                detail="${line##*UNAVAILABLE }"
                if [ -n "$current" ]; then
                    unavailable=$((unavailable+1))
                    if [ "$COLOR_ENABLED" = 1 ]; then printf "[%s %03d] %s — %s\n" "$(t STRATEGY)" "$current_idx" "$current" "$(colorize "$C_RED" "$(t STRATEGY_UNAVAILABLE) — $detail")"; else say "[$(t STRATEGY) $(printf '%03d' "$current_idx")] $current — $(t STRATEGY_UNAVAILABLE) — $detail"; fi
                    current=""; current_idx=0
                fi
                ;;
            *'checking prerequisites'*|*'checking DNS'*|*'searching working DoH server'*|*'preparing nfqws2 redirection'*|*'installed curl version does not support http3'*|*WARNING*)
                translate_blockcheck_info "$line"
                ;;
            *'curl: ('*)
                ;;
        esac
    done
    flush_pending_port
    if [ -n "$current" ]; then
        if [ "$COLOR_ENABLED" = 1 ]; then printf "[%s %03d] %s — %s\n" "$(t STRATEGY)" "$current_idx" "$current" "$(colorize "$C_YELLOW" "$(t RESULT): $(t STRATEGY_UNAVAILABLE)")"; else say "[$(t STRATEGY) $(printf '%03d' "$current_idx")] $current — $(t STRATEGY_UNAVAILABLE)"; fi
        unavailable=$((unavailable+1))
    fi
    say '------------------------------------------------------------'
    if [ "${LANG_MODE:-RU}" = RU ]; then
        say "[$(t TAG_SUMMARY)] $label: available=$available unavailable=$unavailable"
    else
        say "[SUMMARY] $label: AVAILABLE=$available NOT_WORKING=$unavailable"
    fi
}
ask_save_blockcheck() {
    pattern="$1"
    if [ "${LANG_MODE:-RU}" = RU ]; then printf 'Сохранить raw-отчёт blockcheck? [y/N] '; else printf 'Save raw blockcheck report? [y/N] '; fi
    read save || save=n
    case "$save" in
      y|Y)
        say "[$(t TAG_SAVED)] Report remains in $BLOCKDIR"
        ls -1t "$BLOCKDIR"/$pattern 2>/dev/null | head -n 10 || true
        ;;
      *)
        for f in "$BLOCKDIR"/$pattern; do [ -f "$f" ] && rm -f "$f"; done
        say "[$(t TAG_NOT_SAVED)] Raw blockcheck captures removed."
        ;;
    esac
}

strategy_hash() {
    value="$1"
    if has cksum; then
        printf '%s' "$value" | cksum | awk '{print $1}'
        return 0
    fi
    if has md5sum; then
        printf '%s' "$value" | md5sum | awk '{print $1}'
        return 0
    fi
    if has sha256sum; then
        printf '%s' "$value" | sha256sum | awk '{print $1}'
        return 0
    fi
    # Last-resort deterministic fallback for minimal BusyBox systems.
    printf '%s' "$value" | awk 'BEGIN{h=5381} {for(i=1;i<=length($0);i++){c=substr($0,i,1); h=(h*33+index("0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ -_./:=,",c)) % 2147483647}} END{print h}'

}

make_candidate_db() {
    engine="$1"; src="$2"; cand="$3"; namespace="${4:-S}"
    db="$BLOCKDIR/${engine}.db"; : > "$db"
    n=0
    case "$namespace" in
        C) id_prefix="${engine}-C" ;;
        *) id_prefix="${engine}-S" ;;
    esac
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        n=$((n+1)); id="${id_prefix}$(printf '%04d' "$n")"
        hash="$(strategy_hash "$line")"
        printf '%s|%s|%s|CANDIDATE|%s\n' "$id" "$engine" "$hash" "$line" >> "$db"
    done < "$cand"
}

# ---------- temporary NFQUEUE hook ----------
kill_running() {
    [ -f "$PIDFILE" ] || return 0
    p="$(cat "$PIDFILE" 2>/dev/null || true)"
    [ -n "$p" ] && kill "$p" 2>/dev/null || true
    sleep 1
    [ -n "$p" ] && kill -9 "$p" 2>/dev/null || true
    rm -f "$PIDFILE"
}

make_target_ips() {
    : > "$RUN/target.v4"; : > "$RUN/target.v6"
    while IFS= read -r s; do
        rec="$(service_record "$s")"; IFS='|' read -r _ _ domains _ _ _ _ _ <<EOF2
$rec
EOF2
        for d in $domains; do
            resolve_ips_for_strategy "$d" | tr ' ' '\n' | while IFS= read -r ip; do
                [ -n "$ip" ] || continue
                case "$ip" in *:*) echo "$ip" >> "$RUN/target.v6";; *) echo "$ip" >> "$RUN/target.v4";; esac
            done
        done
    done < "$STATE/services.list"
    sort -u "$RUN/target.v4" -o "$RUN/target.v4" 2>/dev/null || true
    sort -u "$RUN/target.v6" -o "$RUN/target.v6" 2>/dev/null || true
}

start_candidate_fw_nft() {
    has nft || return 1
    nft add table inet "$NFT_TABLE" || return 1
    nft "add chain inet $NFT_TABLE out { type filter hook postrouting priority 101; policy accept; }" || return 1
    nft "add chain inet $NFT_TABLE pre { type filter hook prerouting priority -101; policy accept; }" || return 1
    nft "add rule inet $NFT_TABLE out meta mark and 0x10000000 != 0 return" || return 1
    nft "add rule inet $NFT_TABLE pre meta mark and 0x10000000 != 0 return" || return 1
    if [ -s "$RUN/target.v4" ]; then
        ips="$(tr '\n' ',' < "$RUN/target.v4" | sed 's/,$//')"
        nft "add rule inet $NFT_TABLE out ip daddr { $ips } tcp dport {80,443} queue num $QNUM bypass" || return 1
        [ "$ENABLE_UDP" = 1 ] && nft "add rule inet $NFT_TABLE out ip daddr { $ips } udp dport 443 queue num $QNUM bypass" || true
        nft "add rule inet $NFT_TABLE pre ip saddr { $ips } tcp sport {80,443} queue num $QNUM bypass" || true
        [ "$ENABLE_UDP" = 1 ] && nft "add rule inet $NFT_TABLE pre ip saddr { $ips } udp sport 443 queue num $QNUM bypass" || true
    fi
    if [ "$TEST_IPV6" = 1 ] && [ -s "$RUN/target.v6" ]; then
        ips6="$(tr '\n' ',' < "$RUN/target.v6" | sed 's/,$//')"
        nft "add rule inet $NFT_TABLE out ip6 daddr { $ips6 } tcp dport {80,443} queue num $QNUM bypass" || return 1
        [ "$ENABLE_UDP" = 1 ] && nft "add rule inet $NFT_TABLE out ip6 daddr { $ips6 } udp dport 443 queue num $QNUM bypass" || true
        nft "add rule inet $NFT_TABLE pre ip6 saddr { $ips6 } tcp sport {80,443} queue num $QNUM bypass" || true
        [ "$ENABLE_UDP" = 1 ] && nft "add rule inet $NFT_TABLE pre ip6 saddr { $ips6 } udp sport 443 queue num $QNUM bypass" || true
    fi
    return 0
}

start_candidate_fw_iptables() {
    has iptables || return 1
    iptables -t mangle -N "$IPT_CHAIN" 2>/dev/null || true
    iptables -t mangle -F "$IPT_CHAIN" || return 1
    iptables -t mangle -C OUTPUT -j "$IPT_CHAIN" 2>/dev/null || iptables -t mangle -A OUTPUT -j "$IPT_CHAIN" || return 1
    while IFS= read -r ip; do
        [ -n "$ip" ] || continue
        iptables -t mangle -A "$IPT_CHAIN" -d "$ip" -p tcp -m multiport --dports 80,443 -j NFQUEUE --queue-num "$QNUM" --queue-bypass || return 1
        [ "$ENABLE_UDP" = 1 ] && iptables -t mangle -A "$IPT_CHAIN" -d "$ip" -p udp --dport 443 -j NFQUEUE --queue-num "$QNUM" --queue-bypass || true
    done < "$RUN/target.v4"
    return 0
}

start_worker() {
    engine="$1"; args="$2"
    kill_running
    case "$engine" in
      ZAPRET)
        [ -x "$NFQWS" ] || return 1
        # Upstream requires --qnum on current zapret generations.
        # Only qnum is injected by the harness; all desync options are candidate data.
        # shellcheck disable=SC2086
        "$NFQWS" --qnum="$QNUM" --dpi-desync-fwmark=0x10000000 $args >"$DEBUGDIR/worker.out" 2>"$DEBUGDIR/worker.err" &
        ;;
      ZAPRET2)
        [ -x "$NFQWS2" ] || return 1
        [ -f "$ZAPRET2_BASE/lua/zapret-lib.lua" ] || return 1
        [ -f "$ZAPRET2_BASE/lua/zapret-antidpi.lua" ] || return 1
        # These Lua libs are upstream zapret2 components, and are loaded explicitly by upstream init.
        # shellcheck disable=SC2086
        "$NFQWS2" --qnum="$QNUM" --fwmark=0x10000000 --lua-init=@"$ZAPRET2_BASE/lua/zapret-lib.lua" --lua-init=@"$ZAPRET2_BASE/lua/zapret-antidpi.lua" $args >"$DEBUGDIR/worker.out" 2>"$DEBUGDIR/worker.err" &
        ;;
      *) return 1;;
    esac
    echo $! > "$PIDFILE"
    sleep 1
    kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

# ---------- strategy verification ----------
test_domain_set() {
    engine="$1"; args="$2"; attempts="$3"; strategy="$4"
    make_target_ips || true
    case "$FWTYPE" in nftables) start_candidate_fw_nft;; *) start_candidate_fw_iptables;; esac || return 1
    start_worker "$engine" "$args" || { cleanup_ours; return 1; }; sleep "$WAIT_AFTER_RESTART"
    pass=0; total=0; untested=0; : > "$RUN/current-results"
    while IFS= read -r s; do
        rec="$(service_record "$s")"; IFS='|' read -r _ _ domains _ _ htt https quic <<EOF2
$rec
EOF2
        for d in $domains; do
            a=1
            while [ "$a" -le "$attempts" ]; do
                dns="$(dns_probe "$d" 2>/dev/null || true)"; resolve_ip=""
                case "$dns" in
                    PASS\|*) resolve_ip="$(printf '%s' "$dns" | cut -d'|' -f2)";;
                    DNS_SYNTHETIC*|DNS_FAILURE*) doh_result="$(dns_integrity_probe "$d" 2>/dev/null || true)"; resolve_ip="$(printf '%s' "$doh_result" | cut -d'|' -f4)"; [ -n "$resolve_ip" ] && dns="PASS|$resolve_ip|DOH";;
                esac
                if [ -z "$resolve_ip" ] || is_synthetic_ip "$resolve_ip"; then
                    untested=$((untested+1)); echo "$s|$d|${dns:-NO_DATA}|NA|NA|NA" >> "$RUN/current-results"; a=$((a+1)); continue
                fi
                total=$((total+1)); http="NA"; httpsr="NA"; h3="NA"; curl_resolve="--resolve ${d}:80:${resolve_ip} --resolve ${d}:443:${resolve_ip}"
                [ "$htt" = 1 ] && http="$(curl_probe "http://$d" "$curl_resolve")"
                [ "$https" = 1 ] && httpsr="$(curl_probe "https://$d" "$curl_resolve")"
                [ "$ENABLE_HTTP3" = 1 ] && [ "$quic" = 1 ] && { if http3_capable; then h3="$(curl_probe "https://$d" "$curl_resolve --http3-only")"; else h3='2|UNAVAILABLE|0|NA|'; fi; }
                echo "$s|$d|$dns|$http|$httpsr|$h3" >> "$RUN/current-results"
                case "$httpsr" in *'|PASS|'*|0'|PASS|'*) pass=$((pass+1));; esac
                a=$((a+1))
            done
        done
    done < "$STATE/services.list"
    kill_running; cleanup_ours; printf '%s|%s|%s\n' "$pass" "$total" "$untested"
}

control_test() {
    strategy="$1"; args="$2"; engine="$3"
    [ -f "$CONTROL" ] || { echo 0; return; }
    make_target_ips || true
    case "$FWTYPE" in nftables) start_candidate_fw_nft;; *) start_candidate_fw_iptables;; esac || { echo 1; return; }
    start_worker "$engine" "$args" || { cleanup_ours; echo 1; return; }; sleep "$WAIT_AFTER_RESTART"
    failures=0; checked=0
    while IFS= read -r d; do
        [ -n "$d" ] || continue
        dns="$(dns_probe "$d" 2>/dev/null || true)"; ip=""
        case "$dns" in PASS\|*) ip="$(printf '%s' "$dns" | cut -d'|' -f2)";; DNS_SYNTHETIC*|DNS_FAILURE*) r="$(dns_integrity_probe "$d" 2>/dev/null || true)"; ip="$(printf '%s' "$r" | cut -d'|' -f4)";; esac
        [ -n "$ip" ] && ! is_synthetic_ip "$ip" || continue
        checked=$((checked+1)); r="$(curl_probe "https://$d" "--resolve ${d}:443:${ip}")"; echo "$r" | grep -q '|PASS|' || failures=$((failures+1))
    done < "$CONTROL"
    kill_running; cleanup_ours; [ "$checked" -gt 0 ] && echo "$failures" || echo 0
}

score_result() {
    pass="$1"; total="$2"; regress="$3"; side="$4"; ms="$5"
    [ "$total" -gt 0 ] || { echo 0; return; }
    base=$((pass*70/total))
    [ "$regress" -gt 0 ] && base=$((base-regress*10))
    [ "$side" -gt 0 ] && base=$((base-side*10))
    [ "$ms" -lt 1000 ] && base=$((base+10))
    [ "$base" -lt 0 ] && base=0
    [ "$base" -gt 100 ] && base=100
    echo "$base"
}

run_strategy_tests() {
    engine="$1"; db="$2"; attempts="$3"
    [ -f "$RUN/strategy-results" ] || : > "$RUN/strategy-results"
    n=0
    STRATEGY_INTERRUPTED=0
    STRATEGY_RUNNING_PID=""
    strategy_signal_handler() {
        STRATEGY_INTERRUPTED=1
        if [ -n "${STRATEGY_RUNNING_PID:-}" ]; then
            kill_tree "$STRATEGY_RUNNING_PID" >/dev/null 2>&1 || true
            kill -KILL "$STRATEGY_RUNNING_PID" 2>/dev/null || true
        fi
        rm -f "$RUN/active.strategy.pid"
    }
    SIGNAL_STAGE=strategy
    while IFS='|' read -r id eng hash status args; do
        [ "$eng" = "$engine" ] || continue
        n=$((n+1))
        say ''
        if [ "$COLOR_ENABLED" = 1 ]; then printf "%s[%s] %s%s\n" "$C_CYAN" "$engine" "$id" "$C_RESET"; else say "[$engine] $id"; fi
        start=$(now_ms)
        result_file="$RUN/strategy-${engine}-${n}.result"
        rm -f "$result_file"
        STRATEGY_INTERRUPTED=0
        timeout_run test_domain_set "$engine" "$args" "$attempts" "$id" >"$result_file" 2>&1 &
        STRATEGY_RUNNING_PID=$!
        printf '%s\n' "$STRATEGY_RUNNING_PID" > "$RUN/active.strategy.pid"
        wait "$STRATEGY_RUNNING_PID" 2>/dev/null
        rc=$?
        end=$(now_ms); elapsed=$((end-start))
        rm -f "$RUN/active.strategy.pid"
        STRATEGY_RUNNING_PID=""

        if [ "$STRATEGY_INTERRUPTED" = 1 ] || [ "$rc" -eq 130 ] || [ "$rc" -eq 143 ]; then
            status2=SKIPPED; score=0; pass=0; total=0; side=0
            printf '%s|%s|%s|%s|%s|%s|%s\n' "$id" "$engine" "$args" "$status2" "$score" "0/0" "$side" >> "$RUN/strategy-results"
            display_status="$status2"
            [ "${LANG_MODE:-RU}" = RU ] && display_status="$(t STATUS_SKIPPED)"
            if [ "$COLOR_ENABLED" = 1 ]; then
                label_status="$(colorize "$C_YELLOW" "$display_status")"
            else
                label_status="$display_status"
            fi
            printf '%-14s %-9s score=%-3s pass=%s elapsed=%sms side=%s\n' "$id" "$label_status" "$score" "0/0" "$elapsed" "$side"
            printf '%-14s %-9s score=%-3s pass=%s elapsed=%sms side=%s\n' "$id" "$status2" "$score" "0/0" "$elapsed" "$side" >> "$REPORT_TXT"
            rm -f "$result_file"
            continue
        fi

        result="$(cat "$result_file" 2>/dev/null || true)"
        pass="$(printf '%s\n' "$result" | awk -F'|' '{print $1}' | tail -n1)"
        total="$(printf '%s\n' "$result" | awk -F'|' '{print $2}' | tail -n1)"
        untested="$(printf '%s\n' "$result" | awk -F'|' '{print $3}' | tail -n1)"
        case "$pass" in ''|*[!0-9]*) pass=0;; esac
        case "$total" in ''|*[!0-9]*) total=0;; esac
        case "$untested" in ''|*[!0-9]*) untested=0;; esac
        if [ "$total" -eq 0 ]; then
            side=0; score=0; status2=SKIPPED
            printf '%s|%s|%s|%s|%s|%s|%s\n' "$id" "$engine" "$args" "$status2" "$score" "0/0" "$side" >> "$RUN/strategy-results"
            display_status="$status2"; [ "${LANG_MODE:-RU}" = RU ] && display_status="$(t STATUS_SKIPPED)"
            printf '%-14s %-11s score=%-3s pass=%s elapsed=%sms side=%s untested=%s\n' "$id" "$display_status" "$score" "0/0" "$elapsed" "$side" "$untested"
            printf '%-14s %-9s score=%-3s pass=%s elapsed=%sms side=%s untested=%s\n' "$id" "$status2" "$score" "0/0" "$elapsed" "$side" "$untested" >> "$REPORT_TXT"
            rm -f "$result_file"
            continue
        fi
        side="$(control_test "$id" "$args" "$engine")"
        [ -n "$side" ] || side=0
        score="$(score_result "$pass" "$total" 0 "$side" "$elapsed")"
        status2=FAIL; [ "$pass" -gt 0 ] && status2=PARTIAL; [ "$pass" -ge "$total" ] && [ "$total" -gt 0 ] && status2=PASS
        printf '%s|%s|%s|%s|%s|%s|%s\n' "$id" "$engine" "$args" "$status2" "$score" "$pass/$total" "$side" >> "$RUN/strategy-results"
        if [ "$COLOR_ENABLED" = 1 ]; then
            display_status="$status2"
            if [ "${LANG_MODE:-RU}" = RU ]; then
                case "$status2" in
                    PASS) display_status="$(t STATUS_PASS)";;
                    PARTIAL) display_status="$(t STATUS_PARTIAL)";;
                    FAIL) display_status="$(t STATUS_FAIL)";;
                    SKIPPED) display_status="$(t STATUS_SKIPPED)";;
                esac
            fi
            case "$status2" in
                PASS) label_status="$(colorize "$C_GREEN" "$display_status")";;
                PARTIAL) label_status="$(colorize "$C_YELLOW" "$display_status")";;
                *) label_status="$(colorize "$C_RED" "$display_status")";;
            esac
            printf '%-14s %-11s score=%-3s pass=%s elapsed=%sms side=%s\n' "$id" "$label_status" "$score" "$pass/$total" "$elapsed" "$side"
        else
            display_status="$status2"
            if [ "${LANG_MODE:-RU}" = RU ]; then
                case "$status2" in
                    PASS) display_status="$(t STATUS_PASS)";;
                    PARTIAL) display_status="$(t STATUS_PARTIAL)";;
                    FAIL) display_status="$(t STATUS_FAIL)";;
                    SKIPPED) display_status="$(t STATUS_SKIPPED)";;
                esac
            fi
            printf '%-14s %-11s score=%-3s pass=%s elapsed=%sms side=%s\n' "$id" "$display_status" "$score" "$pass/$total" "$elapsed" "$side"
        fi
        printf '%-14s %-9s score=%-3s pass=%s elapsed=%sms side=%s\n' "$id" "$status2" "$score" "$pass/$total" "$elapsed" "$side" >> "$REPORT_TXT"
        rm -f "$result_file"
    done < "$db"
    SIGNAL_STAGE=""
    STRATEGY_RUNNING_PID=""
}

