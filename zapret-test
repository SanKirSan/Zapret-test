Hostkey Paris|spd-frsrv.hostkey.com"
        printf "%-22s %-28s %-8s %-8s %-8s\n" TARGET ADDRESS AVG_MS LOSS STATUS
        printf "%-22s %-28s %-8s %-8s %-8s\n" ---------------------- ---------------------------- -------- -------- --------
        total=0; reachable=0
        old_ifs="$IFS"; IFS="$(printf "\nX")"; IFS="${IFS%X}"
        for row in $TARGETS; do
            IFS="|" read -r name addr <<EOF2
$row
EOF2
            IFS="$(printf "\nX")"; IFS="${IFS%X}"
            total=$((total+1))
            if [ "$addr" = N/A ]; then
                avg="-"; loss="-"; status=NO_GATEWAY
            else
                out="$(ping -4 -c 3 -W 2 "$addr" 2>&1 || true)"
                avg="$(printf "%s" "$out" | sed -n "s/.*= *[0-9.]*\/\([0-9.]*\)\/[0-9.]*.*$/\1/p" | head -n1)"
                loss="$(printf "%s" "$out" | sed -n "s/.*\([0-9][0-9]*\)% packet loss.*/\1/p" | head -n1)"
                [ -n "$avg" ] || avg="-"
                [ -n "$loss" ] || loss="100"
                if [ "$loss" -lt 100 ]; then status=REACHABLE; reachable=$((reachable+1)); else status=NO_REPLY; fi
            fi
            [ "$addr" = N/A ] && printf "%-22s %-28s %-8s %-8s %-8s\n" "$name" "$addr" "$avg" "$loss" "$status" || printf "%-22s %-28s %-8s %-8s %-8s\n" "$name" "$addr" "$avg" "${loss}%" "$status"
        done
        IFS="$old_ifs"
        echo
        printf "Доступно: %s/%s\n" "$reachable" "$total"
        echo "Примечание: отсутствие ICMP-ответа не доказывает блокировку сервиса; многие серверы игнорируют ping."
        if [ "$reachable" -eq 0 ]; then echo "RESULT: NO_PING_REPLIES"; exit 1; fi
        echo "RESULT: PING_REACHABILITY_OK"
    '
}

