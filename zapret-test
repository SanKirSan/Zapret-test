ui_pause() { t PRESS_ENTER; read dummy || true; }
timeout_works() { has timeout && timeout 1 true >/dev/null 2>&1; }
internal_timeout() {
    limit="$1"; shift
    case "$limit" in
        ""|*[!0-9]*) "$@"; return $? ;;
    esac
    [ "$limit" -gt 0 ] || { "$@"; return $?; }
    "$@" &
    child="$!"
    start="$(date +%s 2>/dev/null || echo 0)"
    while :; do
        state="$(ps -o stat= -p "$child" 2>/dev/null | tr -d " ")"
        [ -n "$state" ] || break
        case "$state" in Z*) break;; esac
        now="$(date +%s 2>/dev/null || echo "$start")"
        elapsed=$((now-start))
        if [ "$elapsed" -ge "$limit" ]; then
            kill_tree "$child" 2>/dev/null || kill -TERM "$child" 2>/dev/null || true
            sleep 1
            kill -KILL "$child" 2>/dev/null || true
            wait "$child" 2>/dev/null || true
            return 124
        fi
        sleep 1
    done
    wait "$child" 2>/dev/null
    return $?
}
