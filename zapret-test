external_native_curl_smoke() {
    external_check_dependencies 'HTTP/HTTPS connectivity' curl dig jq || return 0
    run_native_test http-smoke 'HTTP/HTTPS + DNS integrity' sh -c '
        urls="https://example.com https://openwrt.org https://github.com https://discord.com https://youtube.com https://rutracker.org"
        for u in $urls; do
            host="$(printf "%s" "$u" | sed "s#^[a-zA-Z]*://##; s#/.*##")"
            echo
            echo "=== $u ==="
            sys=$(dig +short "$host" A 2>/dev/null | grep -E "^[0-9.]+$" | head -n1 || true)
            doh=$(curl -fsS --connect-timeout 5 --max-time 10 -H "accept: application/dns-json" "https://cloudflare-dns.com/dns-query?name=$host&type=A" 2>/dev/null | jq -r ".Answer[]?.data" 2>/dev/null | grep -E "^[0-9.]+$" | head -n1 || true)
            printf "DNS(system)=%s DNS(DoH)=%s" "${sys:-FAIL}" "${doh:-FAIL}"
            if [ -n "$sys" ] && [ -n "$doh" ] && [ "$sys" != "$doh" ]; then printf " [MISMATCH]"; fi
            echo
            curl -4 -sS -o /dev/null --connect-timeout 10 --max-time 15 -w "HTTP=%{http_code} IP=%{remote_ip} DNS_TIME=%{time_namelookup}s CONNECT=%{time_connect}s TLS=%{time_appconnect}s TTFB=%{time_starttransfer}s TOTAL=%{time_total}s\n" "$u" 2>&1 || true
        done
        echo
        echo "198.18.0.0/15 is explicitly treated as synthetic/test address space; if a target resolves there, DNS interception is reported instead of treating it as a genuine remote IP."
    '
}

