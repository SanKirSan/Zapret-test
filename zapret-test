external_censor_native() {
    mode="$1"
    external_check_dependencies "Censorcheck-like $mode" curl dig || return 0
    if [ "$mode" = dpi ]; then
        domains='youtube.com discord.com instagram.com facebook.com x.com linkedin.com rutracker.org digitalocean.com amnezia.org getoutline.org mailfence.com flibusta.is rezka.ag api.telegram.org play.google.com'
        label="$(t DPI)"
    else
        domains='spotify.com netflix.com patreon.com swagger.io snyk.io mongodb.com autodesk.com graylog.org redis.io copilot.microsoft.com'
        label="$(t GEOBLOCK)"
    fi
    run_native_test "censor-$mode" "$label — native OpenWrt implementation" sh -c '
        domains="$1"
        printf "%-27s %-12s %-8s %-8s %-18s\n" DOMAIN DNS HTTP HTTPS RESULT
        printf "%-27s %-12s %-8s %-8s %-18s\n" --------------------------- ------------ -------- -------- ------------------
        for d in $domains; do
            sys=$(dig +short "$d" A 2>/dev/null | grep -E "^[0-9.]+$" | head -n1 || true)
            dns=FAIL; [ -n "$sys" ] && dns=OK
            if [ -z "$sys" ]; then
                printf "%-27s %-12s %-8s %-8s %-18s\n" "$d" "$dns" N/A N/A DNS_FAIL; continue
            fi
            # Synthetic DNS ranges used by some local filtering setups are explicitly flagged.
            result=RESPONDED
            echo "$sys" | grep -Eq "^(198\\.18\\.|198\\.19\\.)" && dns=INTERCEPTED
            http=$(curl -4 -sS -o /dev/null --connect-timeout 5 --max-time 12 -w "%{http_code}" "http://$d" 2>/dev/null)
            https=$(curl -4 -sS -o /dev/null --connect-timeout 5 --max-time 12 -w "%{http_code}" "https://$d" 2>/dev/null)
            [ -n "$http" ] || http=000
            [ -n "$https" ] || https=000
            case "$http:$https" in
              000:000) result=UNREACHABLE;;
              *:000|000:*) result=PARTIAL;;
              *) result=RESPONDED;;
            esac
            printf "%-27s %-12s %-8s %-8s %-18s\n" "$d" "$dns" "$http" "$https" "$result"
        done
        echo
        echo "NOTE: HTTP/HTTPS status is an endpoint response, not proof of full application functionality. 3xx and 403 are not automatically blocks."
    ' sh "$domains"
}

external_ru_iperf_native() {
    external_check_dependencies 'Russian iPerf3 native check' curl iperf3 jq awk sed || return 0
    run_native_test russian-iperf3 "$(t IPERF) — native OpenWrt check" sh -c '
        set -u

        # Public Russian iPerf server pairs. Kept locally so this check does not
        # depend on downloading or parsing a remote Bash benchmark script.
        TESTS="Moscow|spd-rudp.hostkey.ru|Tver|st.tver.ertelecom.ru
Saint Petersburg|st.spb.ertelecom.ru|Yaroslavl|st.yar.ertelecom.ru
Nizhny Novgorod|st.nn.ertelecom.ru|Nizhny Novgorod|speed-nn.vtt.net
Chelyabinsk|st.chel.ertelecom.ru|Magnitogorsk|st.mgn.ertelecom.ru
Tyumen|st.tmn.ertelecom.ru|Krasnoyarsk|st.krsk.ertelecom.ru"

        DISCOVERY_TIMEOUT=15
        TEST_DURATION=5
        STREAMS=8

        # Public examples for these servers explicitly use IPv4. Force -4 so an
        # unrelated IPv6/AAAA route cannot make a healthy IPv4 server look dead.
        find_port() {
            host="$1"
            [ -n "$host" ] || return 1
            for p in 5201 5202 5203 5204 5205 5206 5207 5208 5209; do
                out="$(internal_timeout "$DISCOVERY_TIMEOUT" iperf3 -4 -c "$host" -p "$p" -t 1 -J 2>/dev/null || true)"
                bps="$(printf "%s" "$out" | jq -r ".end.sum_received.bits_per_second // 0" 2>/dev/null || printf "0")"
                case "$bps" in
                    ""|0|0.0|0.00) ;;
                    *[!0-9.]*) ;;
                    *) printf "%s" "$p"; return 0 ;;
                esac
            done
            return 1
        }

        measure_direction() {
            host="$1"; port="$2"; reverse="$3"
            if [ "$reverse" = 1 ]; then
                internal_timeout "$DISCOVERY_TIMEOUT" iperf3 -4 -c "$host" -p "$port" -P "$STREAMS" -t "$TEST_DURATION" -R -J 2>/dev/null || true
            else
                internal_timeout "$DISCOVERY_TIMEOUT" iperf3 -4 -c "$host" -p "$port" -P "$STREAMS" -t "$TEST_DURATION" -J 2>/dev/null || true
            fi
        }

        extract_bps() {
            json="$1"; field="$2"
            printf "%s" "$json" | jq -r "$field // 0" 2>/dev/null
        }

        valid_json() {
            json="$1"
            printf "%s" "$json" | jq -e "((.end.sum_sent.bits_per_second // 0) > 0) and ((.end.sum_received.bits_per_second // 0) > 0) and ((.error? // \"\") == \"\")" >/dev/null 2>&1
        }

        ping_avg() {
            host="$1"
            if command -v ping >/dev/null 2>&1; then
                v="$(ping -4 -c 3 -W 2 "$host" 2>/dev/null | sed -n "s/.*= *[0-9.]*\/\([0-9.]*\)\/[0-9.]*.*$/\1/p" | head -n1)"
                [ -n "$v" ] && { printf "%s" "$v"; return; }
            fi
            printf "%s" "N/A"
        }

        printf "%-18s %-30s %-6s %-8s %-11s %-11s %-12s\n" CITY SERVER PORT PING DOWNLOAD UPLOAD STATUS
        printf "%-18s %-30s %-6s %-8s %-11s %-11s %-12s\n" ------------------ ------------------------------ ------ -------- ----------- ----------- ------------

        total=0
        ok_count=0
        old_ifs="$IFS"
        IFS="$(printf "\nX")"; IFS="${IFS%X}"

        for row in $TESTS; do
            IFS="|" read -r city primary fallback_city fallback_host <<EOF2
$row
EOF2
            IFS="$(printf "\nX")"; IFS="${IFS%X}"
            total=$((total+1))

            host=""
            display_city="$city"
            port=""
            primary_ping="$(ping_avg "$primary")"
            fallback_ping="N/A"

            if p="$(find_port "$primary")"; then
                host="$primary"
                port="$p"
            else
                fallback_ping="$(ping_avg "$fallback_host")"
                if p="$(find_port "$fallback_host")"; then
                    host="$fallback_host"
                    display_city="$fallback_city (fallback)"
                    port="$p"
                fi
            fi

            if [ -z "$port" ]; then
                printf "%-18s %-30s %-6s %-8s %-11s %-11s %-12s\n" "$city" "$primary" - "$primary_ping" - - TCP_DOWN
                continue
            fi

            upload_json="$(measure_direction "$host" "$port" 0)"
            download_json="$(measure_direction "$host" "$port" 1)"
            upload_ok=0
            download_ok=0
            valid_json "$upload_json" && upload_ok=1
            valid_json "$download_json" && download_ok=1

            if [ "$upload_ok" -eq 1 ]; then
                up_field=".end.sum_sent.bits_per_second"
                up_bps="$(extract_bps "$upload_json" "$up_field")"
                up="$(awk -v x="${up_bps:-0}" "BEGIN {printf \"%.1f\", x/1000000}")"
            else
                up="-"
            fi

            if [ "$download_ok" -eq 1 ]; then
                down_field=".end.sum_received.bits_per_second"
                down_bps="$(extract_bps "$download_json" "$down_field")"
                down="$(awk -v x="${down_bps:-0}" "BEGIN {printf \"%.1f\", x/1000000}")"
            else
                down="-"
            fi

            pingv="$(ping_avg "$host")"
            if [ "$upload_ok" -eq 1 ] && [ "$download_ok" -eq 1 ]; then
                status=OK
                ok_count=$((ok_count+1))
            elif [ "$upload_ok" -eq 1 ] || [ "$download_ok" -eq 1 ]; then
                status=PARTIAL
                ok_count=$((ok_count+1))
            else
                status=MEASURE_FAIL
            fi
            printf "%-18s %-30s %-6s %-8s %-11s %-11s %-12s\n" "$display_city" "$host" "$port" "$pingv" "$down" "$up" "$status"
            sleep 1
        done
        IFS="$old_ifs"

        echo
        echo "Рабочих серверов: $ok_count/$total"
        echo "Режим проверки: сначала ICMP Ping, затем iPerf3 по TCP 5201–5209; измерение 5 с upload + 5 с download, $STREAMS потоков."
        echo "Серверы: primary + fallback. Ping не зависит от открытия TCP-порта iPerf3."
        if [ "$ok_count" -eq 0 ]; then
            echo "RESULT: NO_WORKING_IPERF3_SERVERS"
            exit 1
        fi
        echo "RESULT: AT_LEAST_ONE_SERVER_OK"
    '
}

